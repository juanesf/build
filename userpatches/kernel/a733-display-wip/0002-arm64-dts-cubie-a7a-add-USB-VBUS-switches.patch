From: Juan Sanchez <juanesf91@gmail.com>
Subject: [PATCH] arm64: dts: allwinner: cubie-a7a: add VBUS switches for USB

The Cubie A7A has two load switches feeding the USB ports: U5
(USB_HOST_EN = PM5) for VCC5V0_USB20 (the FE1.1S hub downstream ports
and the AIC8800 on its port 4) and U2 (USB0-DRVVBUS = PL2) for the
USB 3.0 Type-A/OTG port. Jernej's tree declares neither, so the hub and
its devices never see VBUS and do not enumerate. Add both regulator-fixed
nodes and wire them to the usbphy supplies, following the A5E/Avaota A1
pattern and the v1.10 schematic sheet 14.

Signed-off-by: Juan Sanchez <juanesf91@gmail.com>
---
 arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts | 34 ++++++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -102,6 +102,32 @@
 		enable-active-high;
 	};
 
+	/* U5: VBUS of the four downstream ports behind the FE1.1S hub.
+	 * USB_HOST_EN = PM5. Without this the hub and the AIC8800 on its
+	 * port 4 never see VBUS and do not present on USB2/EHCI1. */
+	reg_usb_host_en: usb-host-en {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0-usb20";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&reg_vcc5v>;
+		gpio = <&r_pio 1 5 GPIO_ACTIVE_HIGH>; /* PM5 */
+		enable-active-high;
+		regulator-always-on;
+	};
+
+	/* U2: VBUS of the USB 3.0 Type-A / OTG port (USB0-DRVVBUS = PL2). */
+	reg_usb0_drvvbus: usb0-drvvbus {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0-usb30-otg";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&reg_vcc5v>;
+		gpio = <&r_pio 0 2 GPIO_ACTIVE_HIGH>; /* PL2 */
+		enable-active-high;
+		regulator-always-on;
+	};
+
 	reg_ldo2v5: ldo2v5 {
 		/* SY8089A buck feeding the PMIC BLDO and CLDO groups */
 		compatible = "regulator-fixed";
@@ -600,6 +626,8 @@
 };
 
 &usbphy {
+	usb0_vbus-supply = <&reg_usb0_drvvbus>;
+	usb1_vbus-supply = <&reg_usb_host_en>;
 	status = "okay";
 };
 
