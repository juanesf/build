diff --git a/drivers/dsp/common/dsp_fdt.c b/drivers/dsp/common/dsp_fdt.c
new file mode 100644
index 00000000000..12bcf0f64cf
--- /dev/null
+++ b/drivers/dsp/common/dsp_fdt.c
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * drivers/dsp/common/dsp_fdt.c
+ *
+ * FDT parsing for HiFi4 DSP configuration.
+ * Adapted from Allwinner BSP to use mainline libfdt APIs.
+ */
+#include <log.h>
+#include <string.h>
+#include <fdt_support.h>
+#include <malloc.h>
+#include <asm/io.h>
+#include <linux/libfdt.h>
+
+#include "imgdts.h"
+#include "dsp_ic.h"
+#include "dsp_fdt.h"
+
+#define UART_NUM (6)
+
+struct dsp_pin_set {
+	u32 port;
+	u32 port_num;
+	u32 mul_sel;
+};
+
+static int match_compatible(const char *path,
+			    const char *compatible_str,
+			    int *nodeoffset)
+{
+	int nodeoff;
+	const char *pstr;
+
+	DSP_DEBUG("dsp:---- name [%s] msg -----\n", path);
+	nodeoff = fdt_path_offset(working_fdt, path);
+	if (nodeoff < 0) {
+		DSP_DEBUG("dsp:find [%s] node err\n", path);
+		return -1;
+	}
+
+	pstr = fdt_getprop(working_fdt, nodeoff, "compatible", NULL);
+	if (pstr) {
+		if (strcmp(pstr, compatible_str) == 0) {
+			*nodeoffset = nodeoff;
+			return 0;
+		}
+		DSP_DEBUG("dsp:expect compatible:[%s], but use compatible:[%s]\n",
+			  compatible_str, pstr);
+		return -1;
+	}
+
+	DSP_DEBUG("dsp:find compatible err\n");
+	return -1;
+}
+
+static int match_status(int nodeoffset)
+{
+	const char *string_val;
+
+	string_val = fdt_getprop(working_fdt, nodeoffset, "status", NULL);
+	if (string_val && strcmp("okay", string_val) == 0)
+		return 0;
+
+	return -1;
+}
+
+static int match_pinctrl_names(int nodeoffset)
+{
+	return fdt_stringlist_search(working_fdt, nodeoffset,
+				    "pinctrl-names", "default");
+}
+
+static int parse_pinctrl_pins(int nodeoffset, const char *propname,
+			      struct dsp_pin_set *pins, int max_pins)
+{
+	const u32 *prop;
+	int len, cells_per_pin, pin_count, i;
+
+	prop = fdt_getprop(working_fdt, nodeoffset, propname, &len);
+	if (!prop || len < 1)
+		return -1;
+
+	cells_per_pin = 5;
+	if ((len / 4) % cells_per_pin != 0)
+		cells_per_pin = len / 4 > 3 ? 5 : (len / 4);
+
+	pin_count = (len / 4) / cells_per_pin;
+	if (pin_count > max_pins)
+		pin_count = max_pins;
+
+	for (i = 0; i < pin_count; i++) {
+		pins[i].port = fdt32_to_cpu(prop[i * cells_per_pin + 0]);
+		pins[i].port_num = fdt32_to_cpu(prop[i * cells_per_pin + 1]);
+		pins[i].mul_sel = fdt32_to_cpu(prop[i * cells_per_pin + 2]);
+	}
+
+	return pin_count;
+}
+
+int dts_dsp_status(struct dts_msg_t *pmsg, u32 dsp_id)
+{
+	const char *compatible_str = DSP_STATUS_STR;
+	int nodeoff = 0;
+	int ret;
+	char str[20];
+
+	memset(str, 0, sizeof(str));
+	sprintf(str, "dsp%d", dsp_id);
+	ret = match_compatible(str, compatible_str, &nodeoff);
+	if (ret < 0) {
+		DSP_DEBUG("dsp%d:dts no config [%s]\n", dsp_id, str);
+		return -1;
+	}
+
+	DSP_DEBUG("dsp%d:dts can find config [%s]\n", dsp_id, str);
+
+	ret = match_status(nodeoff);
+	if (ret < 0) {
+		pmsg->dsp_status = DTS_CLOSE;
+		DSP_DEBUG("%s status is close\n", str);
+		return -1;
+	}
+	pmsg->dsp_status = DTS_OPEN;
+	return 0;
+}
+
+int dts_uart_msg(struct dts_msg_t *pmsg, u32 dsp_id)
+{
+	const char *compatible_str = DSP_UART_STR;
+	int i, nodeoff, ret, pin_count;
+	char str[20];
+	struct dsp_pin_set pin_set[32];
+
+	for (i = 0; i < UART_NUM; i++) {
+		memset(str, 0, sizeof(str));
+		sprintf(str, "serial%d", i);
+		ret = match_compatible(str, compatible_str, &nodeoff);
+		if (ret < 0)
+			continue;
+		DSP_DEBUG("dsp%d:dts can find config [%s]\n", dsp_id, str);
+		break;
+	}
+
+	if (i == UART_NUM) {
+		DSP_DEBUG("dsp%d:dts no config [%s]\n", dsp_id, str);
+		return -1;
+	}
+
+	pmsg->uart_msg.uart_port = i;
+	ret = match_status(nodeoff);
+	if (ret < 0) {
+		pmsg->uart_msg.status = DTS_CLOSE;
+		return -1;
+	}
+	pmsg->uart_msg.status = DTS_OPEN;
+
+	ret = match_pinctrl_names(nodeoff);
+	if (ret < 0)
+		return -1;
+
+	memset(str, 0, sizeof(str));
+	sprintf(str, "pinctrl-%d", ret);
+
+	pin_count = parse_pinctrl_pins(nodeoff, str, pin_set, 32);
+	if (pin_count < 2)
+		return -1;
+
+	for (i = 0; i < 2; i++) {
+		pmsg->uart_msg.uart_pin_msg[i].port = pin_set[i].port;
+		pmsg->uart_msg.uart_pin_msg[i].port_num = pin_set[i].port_num;
+		pmsg->uart_msg.uart_pin_msg[i].mul_sel = pin_set[i].mul_sel;
+	}
+
+	return 0;
+}
+
+#define GROUP_NUM (7)
+int dts_gpio_int_msg(struct dts_msg_t *pmsg, u32 dsp_id)
+{
+	const char *compatible_str = DSP_GPIO_INT_STR;
+	const char *group_str[GROUP_NUM] = {"PA", "PB", "PC", "PD", "PE", "PF", "PG"};
+	int nodeoff, ret;
+	unsigned int *pdata;
+	char str[20];
+	const char *pins;
+	int len;
+	int i, j;
+
+	memset(str, 0, sizeof(str));
+	sprintf(str, "dsp%d_gpio_int", dsp_id);
+	ret = match_compatible(str, compatible_str, &nodeoff);
+	if (ret < 0) {
+		DSP_DEBUG("dsp%d:dts no config [%s]\n", dsp_id, str);
+		return -1;
+	}
+
+	DSP_DEBUG("dsp%d:dts can find config [%s]\n", dsp_id, str);
+
+	ret = match_status(nodeoff);
+	if (ret < 0) {
+		memset((void *)&pmsg->gpio_int, 0, sizeof(struct dts_gpio_int_t));
+		return -1;
+	}
+
+	pins = fdt_getprop(working_fdt, nodeoff, "pin-group", &len);
+	if (!pins || len <= 0) {
+		memset((void *)&pmsg->gpio_int, 0, sizeof(struct dts_gpio_int_t));
+		return -1;
+	}
+
+	ret = len;
+	if (ret % 3 != 0) {
+		DSP_DEBUG("dsp%d:[%s] format err\n", dsp_id, str);
+		return -1;
+	}
+	ret /= 3;
+	pdata = &pmsg->gpio_int.gpio_a;
+	for (i = 0; i < ret; i++) {
+		memset(str, 0, sizeof(str));
+		memcpy(str, pins, 2);
+		DSP_DEBUG("[%d]%s\n", i, str);
+		for (j = 0; j < GROUP_NUM; j++) {
+			if (strcmp(str, group_str[j]) == 0) {
+				DSP_DEBUG("---%s ok\n", str);
+				pdata[j] = DTS_OPEN;
+			}
+		}
+		pins += 3;
+	}
+
+	return 0;
+}
+
+int dts_sharespace_msg(struct dts_msg_t *pmsg, u32 dsp_id)
+{
+	const char *compatible_str = DSP_SHARE_SPACE;
+	int i, nodeoff, ret;
+	char str[30];
+	const u32 *reg_data;
+	int len;
+
+	memset(str, 0, sizeof(str));
+	sprintf(str, "share_space%d", dsp_id);
+	ret = match_compatible(str, compatible_str, &nodeoff);
+	if (ret < 0) {
+		DSP_DEBUG("dsp%d:dts no config [%s]\n", dsp_id, str);
+		return -1;
+	}
+	DSP_DEBUG("dsp%d:dts can find config [%s]\n", dsp_id, str);
+
+	ret = match_status(nodeoff);
+	if (ret < 0) {
+		pmsg->dts_sharespace.status = DTS_CLOSE;
+		return -1;
+	}
+
+	pmsg->dts_sharespace.status = DTS_OPEN;
+
+	reg_data = fdt_getprop(working_fdt, nodeoff, "reg", &len);
+	if (!reg_data || len < 6 * sizeof(u32)) {
+		memset((void *)&pmsg->dts_sharespace, 0,
+		       sizeof(struct dts_sharespace_t));
+		return -1;
+	}
+
+	for (i = 0; i < 6; i++)
+		DSP_DEBUG("dsp%d:dts reg[%d]=0x%x\n", dsp_id, i,
+			  fdt32_to_cpu(reg_data[i]));
+
+	pmsg->dts_sharespace.dsp_write_addr = fdt32_to_cpu(reg_data[0]);
+	pmsg->dts_sharespace.dsp_write_size = fdt32_to_cpu(reg_data[1]);
+	pmsg->dts_sharespace.arm_write_addr = fdt32_to_cpu(reg_data[2]);
+	pmsg->dts_sharespace.arm_write_size = fdt32_to_cpu(reg_data[3]);
+	pmsg->dts_sharespace.dsp_log_addr = fdt32_to_cpu(reg_data[4]);
+	pmsg->dts_sharespace.dsp_log_size = fdt32_to_cpu(reg_data[5]);
+
+	return 0;
+}
+
+int dts_get_dsp_memory(ulong *start, u32 *size, u32 id)
+{
+	struct fdt_header *dtb_base = working_fdt;
+	int nodeoffset;
+	const u32 *reg_data;
+	int len;
+
+	if (id == 0) {
+		nodeoffset = fdt_path_offset(dtb_base, "/reserved-memory/dsp0");
+		if (nodeoffset < 0) {
+			pr_err("%s: no /reserved-memory/dsp0 in fdt\n", __func__);
+			return -1;
+		}
+	} else {
+		nodeoffset = fdt_path_offset(dtb_base, "/reserved-memory/dsp1");
+		if (nodeoffset < 0) {
+			pr_err("%s: no /reserved-memory/dsp1 in fdt\n", __func__);
+			return -1;
+		}
+	}
+
+	reg_data = fdt_getprop(dtb_base, nodeoffset, "reg", &len);
+	if (!reg_data || len < 4 * sizeof(u32)) {
+		pr_err("%s: error fdt get reg\n", __func__);
+		return -2;
+	}
+
+	*start = fdt32_to_cpu(reg_data[1]);
+	*size = fdt32_to_cpu(reg_data[3]);
+	DSP_DEBUG("start = 0x%lx size =0x%x\n", *start, *size);
+	return 0;
+}
