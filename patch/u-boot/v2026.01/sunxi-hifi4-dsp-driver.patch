diff --git a/drivers/dsp/sun55i/dsp.c b/drivers/dsp/sun55i/dsp.c
new file mode 100644
index 00000000000..5b056a2f935
--- /dev/null
+++ b/drivers/dsp/sun55i/dsp.c
@@ -0,0 +1,312 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * drivers/dsp/sun55i/dsp.c
+ *
+ * HiFi4 DSP boot driver for Allwinner T527/A523 (sun55iw3)
+ *
+ * Based on sun8iw20 driver from YuzukiHD/FreeRTOS-HIFI4-DSP
+ * and Linux kernel BSP driver (sunxi_rproc_hifi4_boot.c)
+ *
+ * Key differences from sun8iw20:
+ * - AArch64 with 64-bit physical addresses
+ * - DSP CFG registers at 0x07100000 (vs 0x01700000)
+ * - MCU CCU at 0x07102000 for DSP clock gating and resets
+ * - SRAM remap flag at 0x07010364
+ * - No DRAM address remapping (0x10000000 <-> 0x30000000 not used)
+ *
+ * Copyright (c) 2007-2025 Allwinnertech Co., Ltd.
+ * Copyright (c) 2025 Armbian
+ *
+ * This software is licensed under the terms of the GNU General Public
+ * License version 2, as published by the Free Software Foundation, and
+ * may be copied, distributed, and modified under those terms.
+ */
+
+#include <asm/io.h>
+#include <log.h>
+#include <string.h>
+#include <asm/global_data.h>
+
+#include "dsp_reg.h"
+#include "elf.h"
+#include "fdt_support.h"
+#include "platform.h"
+
+#include "../common/dsp_fdt.h"
+#include "../common/dsp_ic.h"
+#include "../common/dsp_img.h"
+
+#define readl_dsp(addr) readl((const volatile void *)(addr))
+#define writel_dsp(val, addr) writel((u32)(val), (volatile void *)(addr))
+
+#define ROUND_DOWN(a, b) ((a) & ~((b)-1))
+#define ROUND_UP(a, b) (((a) + (b)-1) & ~((b)-1))
+
+#define ROUND_DOWN_CACHE(a) ROUND_DOWN(a, CONFIG_SYS_CACHELINE_SIZE)
+#define ROUND_UP_CACHE(a) ROUND_UP(a, CONFIG_SYS_CACHELINE_SIZE)
+
+static void sunxi_dsp_set_runstall(u32 dsp_id, u32 value)
+{
+	u32 reg_val;
+
+	if (dsp_id == 0) {
+		reg_val = readl_dsp(DSP0_CFG_BASE + DSP_CTRL_REG0);
+		reg_val &= ~(1 << BIT_RUN_STALL);
+		reg_val |= (value << BIT_RUN_STALL);
+		writel_dsp(reg_val, (DSP0_CFG_BASE + DSP_CTRL_REG0));
+	}
+}
+
+static int update_reset_vec(u32 img_addr, u32 *run_addr)
+{
+	Elf32_Ehdr *ehdr;
+
+	ehdr = (Elf32_Ehdr *)(ADDR_TPYE)img_addr;
+	if (!*run_addr)
+		*run_addr = ehdr->e_entry;
+
+	return 0;
+}
+
+static int load_image(u32 img_addr, u32 dsp_id)
+{
+	Elf32_Ehdr *ehdr;
+	Elf32_Phdr *phdr;
+	void *dst = NULL;
+	void *src = NULL;
+	int i = 0;
+	ulong mem_start = 0;
+	u32 mem_size = 0;
+
+	ehdr = (Elf32_Ehdr *)(ADDR_TPYE)img_addr;
+	phdr = (Elf32_Phdr *)(ADDR_TPYE)(img_addr + ehdr->e_phoff);
+
+	for (i = 0; i < ehdr->e_phnum; ++i) {
+		dst = (void *)(ADDR_TPYE)phdr->p_paddr;
+		src = (void *)(ADDR_TPYE)img_addr + phdr->p_offset;
+
+		DSP_DEBUG("Loading phdr %i from 0x%x to 0x%p (%i bytes)\n", i,
+			  phdr->p_paddr, dst, phdr->p_filesz);
+
+		if (phdr->p_filesz)
+			memcpy(dst, src, phdr->p_filesz);
+		if (phdr->p_filesz != phdr->p_memsz)
+			memset(dst + phdr->p_filesz, 0x00,
+			       phdr->p_memsz - phdr->p_filesz);
+		if (i == 0)
+			show_img_version((char *)dst + 896, dsp_id);
+
+		++phdr;
+	}
+
+	dts_get_dsp_memory(&mem_start, &mem_size, dsp_id);
+	if (!mem_start || !mem_size) {
+		pr_err("dts_get_dsp_memory fail\n");
+	} else {
+		flush_cache(ROUND_DOWN_CACHE(mem_start),
+			    ROUND_UP_CACHE(mem_size));
+	}
+	return 0;
+}
+
+/*
+ * Configure main CCU DSP clock (offset 0xc70)
+ * Select PLL_PERI0_2X as source with divider to get target frequency.
+ * T527 DSP target: 600MHz from PLL_PERI0_2X (1200MHz) / 2
+ */
+static void dsp_freq_default_set(void)
+{
+	u32 val;
+
+	val = DSP_CLK_SRC_PERI2X | DSP_CLK_FACTOR_M(2) |
+	      (1 << BIT_DSP_SCLK_GATING);
+	writel_dsp(val, (SUNXI_CCM_BASE + CCMU_DSP_CLK_REG));
+}
+
+/*
+ * SRAM remap: controls whether HiFi4 DSP can access its local SRAM.
+ * value=1: CPU uses SRAM (for loading firmware)
+ * value=0: DSP uses SRAM (normal operation)
+ */
+static void sram_remap_set(int value)
+{
+	u32 val;
+
+	val = readl_dsp(SRAM_REMAP_BASE);
+	val &= ~(1 << BIT_SRAM_REMAP_ENABLE);
+	val |= (value << BIT_SRAM_REMAP_ENABLE);
+	writel_dsp(val, SRAM_REMAP_BASE);
+}
+
+/*
+ * Enable MCU CCU bus clocks and deassert resets for DSP.
+ * On T527, clock gating and resets are in the MCU CCU, not the main CCU.
+ *
+ * MCU CCU register map (relative to MCU_CCU_BASE = 0x07102000):
+ *   0x068: Bus DSP MSGBOX clock gate + reset
+ *   0x06c: Bus DSP CFG clock gate + reset
+ *   0x100: DSP mod reset + DSP debug reset
+ */
+static void mcu_ccu_dsp_enable(void)
+{
+	u32 val;
+
+	/* Enable Bus DSP MSGBOX clock gate */
+	val = readl_dsp(MCU_CCU_BASE + MCU_CCU_BUS_DSP_MSGBOX_BGR);
+	val |= (1 << MCU_BIT_DSP_MSGBOX_GATING);
+	writel_dsp(val, MCU_CCU_BASE + MCU_CCU_BUS_DSP_MSGBOX_BGR);
+
+	/* Enable Bus DSP CFG clock gate */
+	val = readl_dsp(MCU_CCU_BASE + MCU_CCU_BUS_DSP_CFG_BGR);
+	val |= (1 << MCU_BIT_DSP_CFG_GATING);
+	writel_dsp(val, MCU_CCU_BASE + MCU_CCU_BUS_DSP_CFG_BGR);
+
+	/* Deassert Bus DSP MSGBOX reset */
+	val = readl_dsp(MCU_CCU_BASE + MCU_CCU_BUS_DSP_MSGBOX_BGR);
+	val |= (1 << 16) | (1 << MCU_BIT_DSP_MSGBOX_RST);
+	writel_dsp(val, MCU_CCU_BASE + MCU_CCU_BUS_DSP_MSGBOX_BGR);
+
+	/* Deassert Bus DSP CFG reset */
+	val = readl_dsp(MCU_CCU_BASE + MCU_CCU_BUS_DSP_CFG_BGR);
+	val |= (1 << 16) | (1 << MCU_BIT_DSP_CFG_RST);
+	writel_dsp(val, MCU_CCU_BASE + MCU_CCU_BUS_DSP_CFG_BGR);
+}
+
+/*
+ * Assert DSP mod and debug resets via MCU CCU before boot.
+ */
+static void mcu_ccu_dsp_assert_reset(void)
+{
+	u32 val;
+
+	/* Assert DSP mod + debug resets (write 1 to bits [16+17] to deassert later) */
+	val = readl_dsp(MCU_CCU_BASE + MCU_CCU_DSP_RST_REG);
+	val &= ~((1 << MCU_BIT_DSP_DEBUG_RST) | (1 << MCU_BIT_DSP_RST));
+	writel_dsp(val, MCU_CCU_BASE + MCU_CCU_DSP_RST_REG);
+}
+
+/*
+ * Deassert DSP mod and debug resets via MCU CCU after configuration.
+ */
+static void mcu_ccu_dsp_deassert_reset(void)
+{
+	u32 val;
+
+	/* Deassert DSP debug reset */
+	val = readl_dsp(MCU_CCU_BASE + MCU_CCU_DSP_RST_REG);
+	val |= (1 << 16) | (1 << MCU_BIT_DSP_DEBUG_RST);
+	writel_dsp(val, MCU_CCU_BASE + MCU_CCU_DSP_RST_REG);
+
+	/* Deassert DSP mod reset */
+	val = readl_dsp(MCU_CCU_BASE + MCU_CCU_DSP_RST_REG);
+	val |= (1 << 17) | (1 << MCU_BIT_DSP_RST);
+	writel_dsp(val, MCU_CCU_BASE + MCU_CCU_DSP_RST_REG);
+}
+
+int sunxi_dsp_init(u32 img_addr, u32 run_ddr, u32 dsp_id)
+{
+	u32 reg_val;
+	u32 image_len = 0;
+	struct dts_msg_t dts_msg;
+	unsigned long section_addr = 0;
+	char *str = ".oemhead.text";
+	int ret = 0;
+
+#ifdef CONFIG_SUNXI_VERIFY_DSP
+	if (sunxi_verify_dsp(img_addr, image_len, dsp_id) < 0) {
+		return -1;
+	}
+#endif
+
+	memset((void *)&dts_msg, 0, sizeof(struct dts_msg_t));
+
+	ret = dts_dsp_status(&dts_msg, dsp_id);
+	if (ret < 0) {
+		printf("dsp%d:dsp close in dts\n", dsp_id);
+		return 0;
+	}
+
+	ret = dts_uart_msg(&dts_msg, dsp_id);
+	if (ret < 0)
+		printf("dsp%d:uart config fail\n", dsp_id);
+
+	ret = dts_gpio_int_msg(&dts_msg, dsp_id);
+	if (ret < 0)
+		printf("dsp%d:gpio init config fail\n", dsp_id);
+
+	ret = dts_sharespace_msg(&dts_msg, dsp_id);
+	if (ret < 0)
+		printf("dsp%d:sharespace config fail\n", dsp_id);
+
+	/* Set CPU access to SRAM (for firmware loading) */
+	sram_remap_set(1);
+
+	/* Parse ELF entry point */
+	update_reset_vec(img_addr, &run_ddr);
+
+	/* Find OEM section in firmware image */
+	ret = find_img_section(img_addr, str, &section_addr);
+	if (ret < 0) {
+		printf("dsp%d:find section err\n", dsp_id);
+		return -1;
+	}
+
+	/* Get firmware length */
+	ret = get_img_len(img_addr, section_addr, &image_len);
+	if (ret < 0) {
+		printf("dsp%d:get img len err\n", dsp_id);
+		return -1;
+	}
+
+	/* Patch DTS message into firmware */
+	ret = set_msg_dts(img_addr, section_addr, &dts_msg);
+	if (ret < 0) {
+		printf("dsp%d:set img dts err\n", dsp_id);
+		return -1;
+	}
+
+	/* Configure main CCU DSP clock: PLL_PERI0_2X / 2 */
+	dsp_freq_default_set();
+
+	/* Enable MCU CCU bus clocks and deassert bus resets */
+	mcu_ccu_dsp_enable();
+
+	/* Assert DSP core resets before configuration */
+	mcu_ccu_dsp_assert_reset();
+
+	if (dsp_id == 0) {
+		/* Set boot vector address */
+		if (run_ddr != DSP_DEFAULT_RST_VEC) {
+			writel_dsp(run_ddr,
+				   DSP0_CFG_BASE + DSP_ALT_RESET_VEC_REG);
+
+			reg_val = readl_dsp(DSP0_CFG_BASE + DSP_CTRL_REG0);
+			reg_val |= (1 << BIT_START_VEC_SEL);
+			writel_dsp(reg_val, DSP0_CFG_BASE + DSP_CTRL_REG0);
+		}
+
+		/* Hold DSP in reset (runstall) */
+		sunxi_dsp_set_runstall(dsp_id, 1);
+
+		/* Enable DSP clock */
+		reg_val = readl_dsp(DSP0_CFG_BASE + DSP_CTRL_REG0);
+		reg_val |= (1 << BIT_DSP_CLKEN);
+		writel_dsp(reg_val, DSP0_CFG_BASE + DSP_CTRL_REG0);
+
+		/* Deassert DSP core resets */
+		mcu_ccu_dsp_deassert_reset();
+
+		/* Load firmware into memory */
+		load_image(img_addr, dsp_id);
+
+		/* Give SRAM access back to DSP */
+		sram_remap_set(0);
+
+		/* Release DSP from reset */
+		sunxi_dsp_set_runstall(dsp_id, 0);
+	}
+
+	printf("DSP%d start ok, img length %d, booting from 0x%x\n", dsp_id,
+	       image_len, run_ddr);
+	return 0;
+}
diff --git a/drivers/dsp/sun55i/dsp_reg.h b/drivers/dsp/sun55i/dsp_reg.h
new file mode 100644
index 00000000000..2757593846f
--- /dev/null
+++ b/drivers/dsp/sun55i/dsp_reg.h
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * drivers/dsp/sun55i/dsp_reg.h
+ *
+ * Register definitions for Allwinner T527/A523 HiFi4 DSP
+ *
+ * Based on sun8iw20 driver from YuzukiHD/FreeRTOS-HIFI4-DSP
+ * and Linux kernel device tree / MCU CCU driver for sun55i-a523.
+ *
+ * Copyright (c) 2007-2025 Allwinnertech Co., Ltd.
+ * Copyright (c) 2025 Armbian
+ *
+ * This software is licensed under the terms of the GNU General Public
+ * License version 2, as published by the Free Software Foundation, and
+ * may be copied, distributed, and modified under those terms.
+ */
+
+#ifndef __DSP_REG_H
+#define __DSP_REG_H
+
+/*
+ * DSP CFG BASE (from sun55i-t527.dtsi: dsp0_rproc hifi4-cfg reg)
+ */
+#define DSP0_CFG_BASE (0x07100000)
+#define DSP0_CFG_SIZE (0x40)
+
+/*
+ * MCU CCU BASE (from sun55i-t527.dtsi: mcu_ccu@7102000)
+ */
+#define MCU_CCU_BASE (0x07102000)
+#define MCU_CCU_SIZE (0x200)
+
+/*
+ * Main CCU BASE (from sun55i-a523.dtsi: ccu@2001000)
+ */
+#define SUNXI_CCM_BASE (0x02001000)
+
+/*
+ * SRAM remap register (from sun55i-t527.dtsi: sram-for-cpux@07010364)
+ */
+#define SRAM_REMAP_BASE (0x07010364)
+
+/*
+ * DSP default reset vector address
+ */
+#define DSP_DEFAULT_RST_VEC (0x100000)
+
+/*
+ * HiFi4 Core Register Offsets (at DSP0_CFG_BASE)
+ * Same register layout as sun8iw20 - HiFi4 core registers are standard
+ */
+#define DSP_ALT_RESET_VEC_REG (0x0000) /* DSP Reset Vector Register */
+#define DSP_CTRL_REG0         (0x0004) /* DSP Control Register 0 */
+#define DSP_BOOT_SRAM_REMAP   (0x0008) /* DSP Boot SRAM Remap Register */
+#define DSP_PRID_REG          (0x000c) /* DSP PRID Register */
+#define DSP_STAT_REG          (0x0010) /* DSP Status Register */
+#define DSP_BIST_CTRL_REG     (0x0014) /* DSP BIST Control Register */
+#define DSP_JTRST_REG         (0x001c) /* DSP JTAG Config Reset Register */
+#define DSP_VER_REG           (0x0020) /* DSP Version Register */
+
+/*
+ * DSP Control Register 0 bits
+ */
+#define BIT_RUN_STALL    (0)
+#define BIT_START_VEC_SEL (1)
+#define BIT_DSP_CLKEN    (2)
+
+/*
+ * DSP PRID Register
+ */
+#define PRID_MASK (0xff << 0)
+
+/*
+ * DSP Status Register bits
+ */
+#define BIT_PFAULT_INFO_VALID (0)
+#define BIT_PFAULT_ERROR      (1)
+#define BIT_DOUBLE_EXCE_ERROR (2)
+#define BIT_XOCD_MODE         (3)
+#define BIT_DEBUG_MODE        (4)
+#define BIT_PWAIT_MODE        (5)
+#define BIT_IRAM0_LOAD_STORE  (6)
+
+/*
+ * BIST Control Register bits
+ */
+#define BIT_BIST_EN             (0)
+#define BIST_WDATA_PAT_MASK    (0x7 << 1)
+#define BIT_BIST_ADDR_MODE_SEL (4)
+#define BIST_REG_SEL_MASK      (0x7 << 5)
+#define BIT_BIST_BUSY          (8)
+#define BIT_BIST_STOP          (9)
+#define BIST_ERR_CYC_MASK     (0x3 << 10)
+#define BIST_ERR_PAT_MASK     (0x7 << 12)
+#define BIT_BIST_ERR_STA      (15)
+#define BIST_SELECT_MASK      (0xf << 16)
+
+/*
+ * DSP Version Register bits
+ */
+#define SMALL_VER_MASK (0x1f << 0)
+#define LARGE_VER_MASK (0x1f << 16)
+
+/*
+ * SRAM Remap Register bits
+ */
+#define BIT_SRAM_REMAP_ENABLE (0)
+
+/*
+ * Main CCU DSP Clock Register (CCU offset 0xc70)
+ * Same offset as sun8iw20 - div/mux/gate
+ */
+#define CCMU_DSP_CLK_REG     (0xc70)
+#define BIT_DSP_SCLK_GATING  (31)
+#define DSP_CLK_M_MASK       (0x1f << 0)
+#define DSP_CLK_SRC_MASK     (0x7 << 24)
+#define DSP_CLK_SRC_HOSC     (0)
+#define DSP_CLK_SRC_32K      (0x1 << 24)
+#define DSP_CLK_SRC_16M      (0x2 << 24)
+#define DSP_CLK_SRC_PERI2X   (0x3 << 24)
+#define DSP_CLK_SRC_PLL_AUDIO1_DIV5 (0x4 << 24)
+/* x must be 1 - 32 */
+#define DSP_CLK_FACTOR_M(x)  (((x)-1) << 0)
+
+/*
+ * MCU CCU Register Offsets (relative to MCU_CCU_BASE = 0x07102000)
+ * From ccu-sun55i-a523-mcu.c in Linux kernel
+ */
+
+/* MCU CCU DSP Clock Register (offset 0x0020) */
+/* Mux: bits [26:24], M divider: bits [4:0], Gate: bit [31] */
+/* Parents: hosc, losc, iosc, pll_audio1_div5, pll_audio1_div2, dsp(from main CCU) */
+#define MCU_CCU_DSP_CLK_REG    (0x0020)
+
+/* MCU CCU Bus Clock Gates */
+#define MCU_CCU_BUS_DSP_MSGBOX_BGR (0x0068) /* Bus DSP MSGBOX gate + reset */
+#define MCU_CCU_BUS_DSP_CFG_BGR    (0x006c) /* Bus DSP CFG gate + reset */
+
+/* MCU CCU DSP Resets */
+#define MCU_CCU_DSP_RST_REG        (0x0100) /* DSP + DSP_DEBUG resets */
+
+/* Bus gate bits */
+#define MCU_BIT_DSP_MSGBOX_GATING (0)
+#define MCU_BIT_DSP_CFG_GATING    (0)
+
+/* Reset bits (active low, bit [16] = assert, write 1 to assert) */
+#define MCU_BIT_DSP_MSGBOX_RST    (0)
+#define MCU_BIT_DSP_CFG_RST       (0)
+#define MCU_BIT_DSP_DEBUG_RST     (16)
+#define MCU_BIT_DSP_RST           (17)
+
+#endif /* __DSP_REG_H */
diff --git a/drivers/dsp/sun55i/platform.h b/drivers/dsp/sun55i/platform.h
new file mode 100644
index 00000000000..167cf4c6e34
--- /dev/null
+++ b/drivers/dsp/sun55i/platform.h
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * drivers/dsp/sun55i/platform.h
+ *
+ * Platform definitions for Allwinner T527/A523 HiFi4 DSP
+ *
+ * Based on sun8iw20 driver from YuzukiHD/FreeRTOS-HIFI4-DSP
+ *
+ * Copyright (c) 2007-2025 Allwinnertech Co., Ltd.
+ * Copyright (c) 2025 Armbian
+ *
+ * This software is licensed under the terms of the GNU General Public
+ * License version 2, as published by the Free Software Foundation, and
+ * may be copied, distributed, and modified under those terms.
+ */
+
+#ifndef __SUNXI_PLATFORM_H
+#define __SUNXI_PLATFORM_H
+
+#include "../common/imgdts.h"
+
+#define RTOS_MAGIC "freertos"
+#define MAGIC_SIZE 8
+#define RTOS_VERSION 1
