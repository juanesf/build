From 816ef42de155a8aee38d68d1eb91ac87c0dc18b4 Mon Sep 17 00:00:00 2001
From: Juan Sanchez <juanesf91@gmail.com>
Date: Wed, 29 Jul 2026 11:45:40 -0400
Subject: [PATCH] arm64: dts: allwinner: a523: add HiFi4 DSP remoteproc node

---
 .../arm64/boot/dts/allwinner/sun55i-a523.dtsi | 44 +++++++++++++++++++
 .../dts/allwinner/sun55i-t527-avaota-a1.dts   | 21 +++++++++
 2 files changed, 65 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
index a4230205c..4e7bc8838 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
@@ -508,6 +508,22 @@ dma: dma-controller@3002000 {
 			#dma-cells = <1>;
 		};
 
+		msgbox: mailbox@3003000 {
+			compatible = "allwinner,sun55iw3-msgbox";
+			reg = <0x03003000 0x0100>,
+			      <0x03003100 0x0100>,
+			      <0x03003200 0x0100>,
+			      <0x03003300 0x0100>;
+			interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_MSGBOX>;
+			resets = <&ccu RST_BUS_MSGBOX>;
+			#mbox-cells = <1>;
+			allwinner,local-id = <0>;
+		};
+
 		sid: efuse@3006000 {
 			compatible = "allwinner,sun55i-a523-sid",
 				     "allwinner,sun50i-a64-sid";
@@ -1029,5 +1045,33 @@ npu: npu@7122000 {
 			resets = <&mcu_ccu RST_BUS_MCU_NPU>;
 			power-domains = <&ppu PD_NPU>;
 		};
+
+		dsp0_rproc: dsp0_rproc@7100000 {
+			compatible = "allwinner,hifi4-rproc";
+			reg = <0x0710C000 0x40>,
+			      <0x07100000 0x40>,
+			      <0x00020000 0x20000>;
+			reg-names = "sram-for-cpux", "hifi4-cfg", "sram";
+			clocks = <&ccu CLK_PLL_PERIPH0_2X>,
+				 <&ccu CLK_DSP>,
+				 <&mcu_ccu CLK_MCU_DSP>,
+				 <&mcu_ccu CLK_BUS_MCU_DSP_CFG>,
+				 <&mcu_ccu CLK_BUS_MCU_DSP>;
+			clock-names = "pll", "mod", "mcu-mod", "cfg", "ahbs";
+			clock-frequency = <528000000>;
+			resets = <&mcu_ccu RST_BUS_MCU_DSP>,
+				 <&mcu_ccu RST_BUS_MCU_DSP_CFG>,
+				 <&mcu_ccu RST_BUS_MCU_DSP_DEBUG>;
+			reset-names = "mod-rst", "cfg-rst", "dbg-rst";
+			firmware-name = "amp_dsp0.bin";
+			memory-mappings =
+				<0x400000    0x10000     0x20000>,
+				<0x420000    0x8000      0x30000>,
+				<0x440000    0x8000      0x38000>,
+				<0x3a000000  0x06000000  0x4a000000>,
+				<0x4a000000  0x00a00000  0x4a000000>;
+			mboxes = <&msgbox 4>;
+			status = "disabled";
+		};
 	};
 };
diff --git a/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts b/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts
index 054d0357c..84d162598 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts
@@ -21,6 +21,22 @@ chosen {
 		stdout-path = "serial0:115200n8";
 	};
 
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		dsp_fw: dsp-fw@4a000000 {
+			reg = <0x0 0x4a000000 0x0 0x00924000>;
+			no-map;
+		};
+
+		dsp_vdev0buffer: dsp-vringbuf@4a924000 {
+			reg = <0x0 0x4a924000 0x0 0x000dc000>;
+			no-map;
+		};
+	};
+
 	ext_osc32k: ext-osc32k-clk {
 		#clock-cells = <0>;
 		compatible = "fixed-clock";
@@ -386,3 +402,8 @@ &usbphy {
 	usb0_vbus_det-gpios = <&pio 8 13 GPIO_ACTIVE_HIGH>; /* PI13 */
 	status = "okay";
 };
+
+&dsp0_rproc {
+	memory-region = <&dsp_fw>, <&dsp_vdev0buffer>;
+	status = "okay";
+};
-- 
2.53.0

