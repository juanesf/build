From db770faed68d4cf168168f43cbdbb4932ecd0e61 Mon Sep 17 00:00:00 2001
From: Juan Sanchez <juanesf91@gmail.com>
Date: Wed, 29 Jul 2026 11:45:41 -0400
Subject: [PATCH] remoteproc: add Allwinner T527/A523 HiFi4 DSP driver

---
 drivers/remoteproc/Kconfig              |  10 +
 drivers/remoteproc/Makefile             |   1 +
 drivers/remoteproc/sun55i_hifi4_rproc.c | 843 ++++++++++++++++++++++++
 3 files changed, 854 insertions(+)
 create mode 100644 drivers/remoteproc/sun55i_hifi4_rproc.c

diff --git a/drivers/remoteproc/Kconfig b/drivers/remoteproc/Kconfig
index ee54436fe..425567d22 100644
--- a/drivers/remoteproc/Kconfig
+++ b/drivers/remoteproc/Kconfig
@@ -380,6 +380,16 @@ config XLNX_R5_REMOTEPROC
 
 	  It's safe to say N if not interested in using RPU r5f cores.
 
+config SUN55I_HIFI4_REMOTEPROC
+	tristate "Allwinner T527/A523 HiFi4 DSP remoteproc support"
+	depends on ARCH_SUNXI
+	depends on REMOTEPROC
+	select MAILBOX
+	help
+	  Say y or m here to support the Xtensa HiFi4 DSP co-processor
+	  found in Allwinner T527/A523 SoCs via the remoteproc framework.
+
+	  It is safe to say N here.
 endif # REMOTEPROC
 
 endmenu
diff --git a/drivers/remoteproc/Makefile b/drivers/remoteproc/Makefile
index 1c7598b84..1f3b595a2 100644
--- a/drivers/remoteproc/Makefile
+++ b/drivers/remoteproc/Makefile
@@ -40,3 +40,4 @@ obj-$(CONFIG_TI_K3_DSP_REMOTEPROC)	+= ti_k3_dsp_remoteproc.o ti_k3_common.o
 obj-$(CONFIG_TI_K3_M4_REMOTEPROC)	+= ti_k3_m4_remoteproc.o ti_k3_common.o
 obj-$(CONFIG_TI_K3_R5_REMOTEPROC)	+= ti_k3_r5_remoteproc.o ti_k3_common.o
 obj-$(CONFIG_XLNX_R5_REMOTEPROC)	+= xlnx_r5_remoteproc.o
+obj-$(CONFIG_SUN55I_HIFI4_REMOTEPROC)	+= sun55i_hifi4_rproc.o
diff --git a/drivers/remoteproc/sun55i_hifi4_rproc.c b/drivers/remoteproc/sun55i_hifi4_rproc.c
new file mode 100644
index 000000000..7431601ca
--- /dev/null
+++ b/drivers/remoteproc/sun55i_hifi4_rproc.c
@@ -0,0 +1,844 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/clk.h>
+#include <linux/dma-mapping.h>
+#include <linux/firmware.h>
+#include <linux/io.h>
+#include <linux/mailbox_client.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/remoteproc.h>
+#include <linux/reset.h>
+#include <linux/workqueue.h>
+#include "remoteproc_internal.h"
+
+#define HIFI4_ALT_RESET_VEC_REG	0x00
+#define HIFI4_CTRL_REG0		0x04
+#define HIFI4_PRID_REG		0x0c
+#define HIFI4_STAT_REG		0x10
+#define HIFI4_VER_REG		0x20
+
+#define BIT_RUN_STALL		0
+#define BIT_START_VEC_SEL	1
+#define BIT_HIFI4_CLKEN		2
+
+#define BIT_SRAM_REMAP_ENABLE	0
+
+#define MBOX_NB_VQ		2
+
+struct sun55i_memory_mapping {
+	u64 da;
+	u64 len;
+	u64 pa;
+};
+
+struct sun55i_mbox {
+	struct mbox_chan *chan;
+	struct mbox_client client;
+	struct work_struct vq_work;
+	int vq_id;
+};
+
+struct sun55i_hifi4_rproc {
+	struct device *dev;
+	struct rproc *rproc;
+
+	void __iomem *hifi4_cfg;
+	void __iomem *sram_remap_reg;
+	void __iomem *sram;
+
+	struct clk *pll_clk;
+	struct clk *mod_clk;
+	struct clk *mcu_mod_clk;
+	struct clk *cfg_clk;
+	struct clk *ahbs_clk;
+
+	struct reset_control *mod_rst;
+	struct reset_control *cfg_rst;
+	struct reset_control *dbg_rst;
+
+	u32 mod_clk_freq;
+
+	struct sun55i_memory_mapping *mem_maps;
+	int mem_maps_cnt;
+
+	struct sun55i_mbox mb;
+	struct workqueue_struct *workqueue;
+
+	u32 pc_entry;
+	size_t sram_size;
+};
+
+static struct sun55i_hifi4_rproc *
+sun55i_rproc_priv(struct rproc *rproc)
+{
+	return (struct sun55i_hifi4_rproc *)rproc->priv;
+}
+
+static int sun55i_da_to_pa(struct rproc *rproc, u64 da, phys_addr_t *pa)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+	int i;
+
+	for (i = 0; i < priv->mem_maps_cnt; i++) {
+		if (da < priv->mem_maps[i].da ||
+		    da >= priv->mem_maps[i].da + priv->mem_maps[i].len)
+			continue;
+		*pa = da - priv->mem_maps[i].da + priv->mem_maps[i].pa;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sun55i_pa_to_da(struct rproc *rproc, phys_addr_t pa, u64 *da)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+	int i;
+
+	for (i = 0; i < priv->mem_maps_cnt; i++) {
+		if (pa < priv->mem_maps[i].pa ||
+		    pa >= priv->mem_maps[i].pa + priv->mem_maps[i].len)
+			continue;
+		*da = pa - priv->mem_maps[i].pa + priv->mem_maps[i].da;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static void *sun55i_da_to_va(struct rproc *rproc, u64 da, size_t len,
+			     bool *is_iomem)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+	struct rproc_mem_entry *carveout;
+	phys_addr_t pa;
+	int ret;
+
+	ret = sun55i_da_to_pa(rproc, da, &pa);
+	if (ret)
+		return NULL;
+
+	if (pa >= 0x20000 && pa < 0x20000 + priv->sram_size) {
+		if (is_iomem)
+			*is_iomem = true;
+		return priv->sram + (pa - 0x20000);
+	}
+
+	list_for_each_entry(carveout, &rproc->carveouts, node) {
+		if (pa >= carveout->dma &&
+		    pa < carveout->dma + carveout->len) {
+			if (is_iomem)
+				*is_iomem = true;
+			return carveout->va + (pa - carveout->dma);
+		}
+	}
+
+	return NULL;
+}
+
+static int sun55i_mem_alloc(struct rproc *rproc, struct rproc_mem_entry *mem)
+{
+	void *va;
+
+	va = ioremap_wc(mem->dma, mem->len);
+	if (!va)
+		return -ENOMEM;
+
+	mem->va = va;
+	return 0;
+}
+
+static int sun55i_mem_release(struct rproc *rproc, struct rproc_mem_entry *mem)
+{
+	iounmap(mem->va);
+	return 0;
+}
+
+static void sun55i_mb_vq_work(struct work_struct *work)
+{
+	struct sun55i_mbox *mb = container_of(work, struct sun55i_mbox, vq_work);
+	struct rproc *rproc = dev_get_drvdata(mb->client.dev);
+
+	if (rproc_vq_interrupt(rproc, mb->vq_id) == IRQ_NONE)
+		dev_dbg(&rproc->dev, "no message in vq%d\n", mb->vq_id);
+}
+
+static void sun55i_mb_rx_callback(struct mbox_client *cl, void *data)
+{
+	struct rproc *rproc = dev_get_drvdata(cl->dev);
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+	struct sun55i_mbox *mb = container_of(cl, struct sun55i_mbox, client);
+
+	mb->vq_id = *(u32 *)data;
+	queue_work(priv->workqueue, &mb->vq_work);
+}
+
+static void sun55i_mb_tx_done(struct mbox_client *cl, void *msg, int r)
+{
+	struct rproc *rproc = dev_get_drvdata(cl->dev);
+
+	devm_kfree(&rproc->dev, msg);
+}
+
+static int sun55i_request_mbox(struct rproc *rproc)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+	struct device *dev = priv->dev;
+
+	if (!of_property_present(dev->of_node, "mboxes"))
+		return 0;
+
+	priv->mb.client.rx_callback = sun55i_mb_rx_callback;
+	priv->mb.client.tx_done = sun55i_mb_tx_done;
+	priv->mb.client.tx_block = false;
+	priv->mb.client.dev = dev;
+
+	priv->mb.chan = mbox_request_channel(&priv->mb.client, 0);
+	if (IS_ERR(priv->mb.chan)) {
+		int ret = PTR_ERR(priv->mb.chan);
+
+		if (ret == -EPROBE_DEFER)
+			return ret;
+		priv->mb.chan = NULL;
+		return 0;
+	}
+	INIT_WORK(&priv->mb.vq_work, sun55i_mb_vq_work);
+	return 0;
+}
+
+static void sun55i_free_mbox(struct rproc *rproc)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+
+	if (priv->mb.chan) {
+		mbox_free_channel(priv->mb.chan);
+		priv->mb.chan = NULL;
+	}
+}
+
+static void sun55i_set_runstall(struct sun55i_hifi4_rproc *priv, u32 value)
+{
+	u32 v;
+
+	v = readl(priv->hifi4_cfg + HIFI4_CTRL_REG0);
+	if (value)
+		v |= BIT(BIT_RUN_STALL);
+	else
+		v &= ~BIT(BIT_RUN_STALL);
+	writel(v, priv->hifi4_cfg + HIFI4_CTRL_REG0);
+}
+
+static void sun55i_set_sram_remap(struct sun55i_hifi4_rproc *priv, u32 value)
+{
+	u32 v;
+
+	v = readl(priv->sram_remap_reg);
+	if (value)
+		v |= BIT(BIT_SRAM_REMAP_ENABLE);
+	else
+		v &= ~BIT(BIT_SRAM_REMAP_ENABLE);
+	writel(v, priv->sram_remap_reg);
+}
+
+static int sun55i_hifi4_reset(struct sun55i_hifi4_rproc *priv)
+{
+	int ret;
+
+	ret = reset_control_assert(priv->mod_rst);
+	if (ret)
+		return ret;
+	ret = reset_control_assert(priv->cfg_rst);
+	if (ret)
+		return ret;
+	return reset_control_assert(priv->dbg_rst);
+}
+
+static int sun55i_hifi4_start(struct rproc *rproc)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+	struct device *dev = priv->dev;
+	int ret, rate;
+
+	sun55i_hifi4_reset(priv);
+
+	ret = clk_prepare_enable(priv->pll_clk);
+	if (ret) {
+		dev_err(dev, "pll clk failed\n");
+		return ret;
+	}
+
+	ret = clk_set_parent(priv->mod_clk, priv->pll_clk);
+	if (ret) {
+		dev_err(dev, "set mod parent failed\n");
+		return ret;
+	}
+
+	rate = clk_round_rate(priv->mod_clk, priv->mod_clk_freq);
+	ret = clk_set_rate(priv->mod_clk, rate);
+	if (ret) {
+		dev_err(dev, "set mod rate failed\n");
+		return ret;
+	}
+
+	ret = clk_prepare_enable(priv->mod_clk);
+	if (ret) {
+		dev_err(dev, "mod clk failed\n");
+		return ret;
+	}
+
+	ret = clk_set_parent(priv->mcu_mod_clk, priv->mod_clk);
+	if (ret) {
+		dev_err(dev, "set mcu-mod parent failed\n");
+		return ret;
+	}
+
+	ret = clk_prepare_enable(priv->mcu_mod_clk);
+	if (ret) {
+		dev_err(dev, "mcu-mod clk failed\n");
+		return ret;
+	}
+
+	ret = clk_prepare_enable(priv->cfg_clk);
+	if (ret) {
+		dev_err(dev, "cfg clk failed\n");
+		return ret;
+	}
+
+	ret = clk_prepare_enable(priv->ahbs_clk);
+	if (ret) {
+		dev_err(dev, "ahbs clk failed\n");
+		return ret;
+	}
+
+	ret = reset_control_deassert(priv->cfg_rst);
+	if (ret) {
+		dev_err(dev, "cfg rst failed\n");
+		return ret;
+	}
+
+	ret = reset_control_deassert(priv->dbg_rst);
+	if (ret) {
+		dev_err(dev, "dbg rst failed\n");
+		return ret;
+	}
+
+	writel(priv->pc_entry, priv->hifi4_cfg + HIFI4_ALT_RESET_VEC_REG);
+
+	{
+		u32 v = readl(priv->hifi4_cfg + HIFI4_CTRL_REG0);
+		v |= BIT(BIT_START_VEC_SEL);
+		writel(v, priv->hifi4_cfg + HIFI4_CTRL_REG0);
+	}
+
+	sun55i_set_runstall(priv, 1);
+
+	{
+		u32 v = readl(priv->hifi4_cfg + HIFI4_CTRL_REG0);
+		v |= BIT(BIT_HIFI4_CLKEN);
+		writel(v, priv->hifi4_cfg + HIFI4_CTRL_REG0);
+	}
+
+	ret = reset_control_deassert(priv->mod_rst);
+	if (ret) {
+		dev_err(dev, "mod rst failed\n");
+		return ret;
+	}
+
+	sun55i_set_sram_remap(priv, 0);
+	sun55i_set_runstall(priv, 0);
+
+	return 0;
+}
+
+static int sun55i_hifi4_stop(struct rproc *rproc)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+
+	clk_disable_unprepare(priv->ahbs_clk);
+	clk_disable_unprepare(priv->cfg_clk);
+	clk_disable_unprepare(priv->mcu_mod_clk);
+	clk_disable_unprepare(priv->mod_clk);
+
+	return sun55i_hifi4_reset(priv);
+}
+
+static int sun55i_hifi4_attach(struct rproc *rproc)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+	int ret, rate;
+
+	ret = clk_prepare_enable(priv->pll_clk);
+	if (ret)
+		return ret;
+	ret = clk_set_parent(priv->mod_clk, priv->pll_clk);
+	if (ret)
+		return ret;
+	rate = clk_round_rate(priv->mod_clk, priv->mod_clk_freq);
+	ret = clk_set_rate(priv->mod_clk, rate);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(priv->mod_clk);
+	if (ret)
+		return ret;
+	ret = clk_set_parent(priv->mcu_mod_clk, priv->mod_clk);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(priv->mcu_mod_clk);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(priv->cfg_clk);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(priv->ahbs_clk);
+	if (ret)
+		return ret;
+	ret = reset_control_deassert(priv->cfg_rst);
+	if (ret)
+		return ret;
+	ret = reset_control_deassert(priv->dbg_rst);
+	if (ret)
+		return ret;
+	return reset_control_deassert(priv->mod_rst);
+}
+
+static void sun55i_hifi4_kick(struct rproc *rproc, int vqid)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+	u32 *msg;
+	int err;
+
+	if (!priv->mb.chan)
+		return;
+	if (WARN_ON(vqid >= MBOX_NB_VQ))
+		return;
+
+	msg = devm_kzalloc(&rproc->dev, sizeof(*msg), GFP_KERNEL);
+	if (!msg)
+		return;
+
+	*msg = vqid;
+	err = mbox_send_message(priv->mb.chan, msg);
+	if (err < 0) {
+		dev_err(&rproc->dev, "kick mbox failed: %d\n", err);
+		devm_kfree(&rproc->dev, msg);
+	}
+}
+
+static int sun55i_hifi4_parse_fw(struct rproc *rproc, const struct firmware *fw)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+	struct elf32_hdr *ehdr = (struct elf32_hdr *)fw->data;
+	int ret;
+
+	priv->pc_entry = ehdr->e_entry;
+
+	ret = rproc_elf_load_rsc_table(rproc, fw);
+	if (ret) {
+		rproc->cached_table = NULL;
+		rproc->table_ptr = NULL;
+		rproc->table_sz = 0;
+		return 0;
+	}
+
+	return 0;
+}
+
+static int sun55i_hifi4_load(struct rproc *rproc, const struct firmware *fw)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+	struct elf32_hdr *ehdr = (struct elf32_hdr *)fw->data;
+	struct elf32_phdr *phdr;
+	const u8 *elf_data = fw->data;
+	int i, ret = 0;
+	u32 da, memsz, filesz, offset;
+	void *ptr;
+
+	sun55i_set_sram_remap(priv, 1);
+
+	ehdr = (struct elf32_hdr *)elf_data;
+	phdr = (struct elf32_phdr *)(elf_data + ehdr->e_phoff);
+
+	for (i = 0; i < ehdr->e_phnum; i++, phdr++) {
+		da = phdr->p_paddr;
+		memsz = phdr->p_memsz;
+		filesz = phdr->p_filesz;
+		offset = phdr->p_offset;
+
+		if (phdr->p_type != PT_LOAD)
+			continue;
+		if (!filesz || !memsz)
+			continue;
+
+		if (filesz > memsz) {
+			dev_err(&rproc->dev, "bad phdr filesz 0x%x > memsz 0x%x\n",
+				filesz, memsz);
+			ret = -EINVAL;
+			break;
+		}
+
+		if (offset + filesz > fw->size) {
+			dev_err(&rproc->dev, "truncated fw\n");
+			ret = -EINVAL;
+			break;
+		}
+
+		ptr = rproc_da_to_va(rproc, da, memsz, NULL);
+		if (!ptr) {
+			dev_err(&rproc->dev,
+				"bad phdr da 0x%x memsz 0x%x\n", da, memsz);
+			ret = -EINVAL;
+			break;
+		}
+
+		if (filesz)
+			memcpy(ptr, elf_data + offset, filesz);
+		if (memsz > filesz)
+			memset(ptr + filesz, 0, memsz - filesz);
+	}
+
+	sun55i_set_sram_remap(priv, 0);
+
+	return ret;
+}
+
+static int sun55i_hifi4_prepare(struct rproc *rproc)
+{
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+	struct device *dev = priv->dev;
+	struct device_node *np = dev->of_node;
+	struct of_phandle_iterator it;
+	struct rproc_mem_entry *mem, *tmp;
+	struct reserved_mem *rmem;
+	int index = 0, ret;
+
+	ret = of_phandle_iterator_init(&it, np, "memory-region", NULL, 0);
+	if (ret)
+		return 0;
+
+	while (of_phandle_iterator_next(&it) == 0) {
+		u64 da;
+
+		rmem = of_reserved_mem_lookup(it.node);
+		if (!rmem) {
+			dev_err(dev, "unable to find memory-region %pOF\n",
+				it.node);
+			return -EINVAL;
+		}
+
+		ret = sun55i_pa_to_da(rproc, rmem->base, &da);
+		if (ret) {
+			dev_err(dev, "memory-region %pa not in mappings\n",
+				&rmem->base);
+			return -EINVAL;
+		}
+
+		mem = rproc_mem_entry_init(dev, NULL,
+					   (dma_addr_t)rmem->base,
+					   rmem->size, da, NULL,
+					   sun55i_mem_release,
+					   index == 1 ? "vdev0buffer" : it.node->name);
+		if (mem) {
+			rproc_coredump_add_segment(rproc, da,
+						   rmem->size);
+			ret = sun55i_mem_alloc(rproc, mem);
+			if (ret)
+				goto clean_up;
+		}
+
+		if (!mem) {
+			ret = -ENOMEM;
+			goto clean_up;
+		}
+
+		rproc_add_carveout(rproc, mem);
+		index++;
+	}
+
+	return 0;
+
+clean_up:
+	list_for_each_entry_safe(mem, tmp, &rproc->carveouts, node) {
+		if (mem->release)
+			mem->release(rproc, mem);
+		list_del(&mem->node);
+		kfree(mem);
+	}
+	return ret;
+}
+
+static int sun55i_hifi4_unprepare(struct rproc *rproc)
+{
+	struct rproc_mem_entry *entry, *tmp;
+
+	list_for_each_entry_safe(entry, tmp, &rproc->carveouts, node) {
+		if (entry->release)
+			entry->release(rproc, entry);
+		list_del(&entry->node);
+		kfree(entry);
+	}
+	return 0;
+}
+
+static int sun55i_hifi4_find_rsc_table(struct rproc *rproc,
+					const struct firmware *fw,
+					struct elf32_shdr **find_shdr)
+{
+	struct elf32_hdr *ehdr = (struct elf32_hdr *)fw->data;
+	struct elf32_shdr *shdr;
+	const char *name_table;
+	const u8 *elf_data = fw->data;
+	u32 i;
+
+	shdr = (struct elf32_shdr *)(elf_data + ehdr->e_shoff);
+	name_table = elf_data + shdr[ehdr->e_shstrndx].sh_offset;
+
+	for (i = 0; i < ehdr->e_shnum; i++, shdr++) {
+		if (strcmp(name_table + shdr->sh_name, ".resource_table"))
+			continue;
+		*find_shdr = shdr;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static struct resource_table *
+sun55i_hifi4_get_loaded_rsc_table(struct rproc *rproc, size_t *table_sz)
+{
+	struct device *dev = &rproc->dev;
+	const struct firmware *fw;
+	struct elf32_shdr *shdr;
+	int ret;
+
+	ret = request_firmware(&fw, rproc->firmware, dev);
+	if (ret < 0)
+		return ERR_PTR(-ENODEV);
+
+	ret = sun55i_hifi4_find_rsc_table(rproc, fw, &shdr);
+	if (ret) {
+		release_firmware(fw);
+		return ERR_PTR(-ENODEV);
+	}
+
+	*table_sz = shdr->sh_size;
+	release_firmware(fw);
+
+	return rproc_da_to_va(rproc, shdr->sh_addr, *table_sz, NULL);
+}
+
+static const struct rproc_ops sun55i_hifi4_rproc_ops = {
+	.prepare	= sun55i_hifi4_prepare,
+	.unprepare	= sun55i_hifi4_unprepare,
+	.start		= sun55i_hifi4_start,
+	.stop		= sun55i_hifi4_stop,
+	.attach		= sun55i_hifi4_attach,
+	.da_to_va	= sun55i_da_to_va,
+	.kick		= sun55i_hifi4_kick,
+	.parse_fw	= sun55i_hifi4_parse_fw,
+	.load		= sun55i_hifi4_load,
+	.get_loaded_rsc_table = sun55i_hifi4_get_loaded_rsc_table,
+	.sanity_check	= rproc_elf_sanity_check,
+	.get_boot_addr	= rproc_elf_get_boot_addr,
+};
+
+static int sun55i_hifi4_parse_dt(struct sun55i_hifi4_rproc *priv)
+{
+	struct device *dev = priv->dev;
+	struct platform_device *pdev = to_platform_device(dev);
+	struct resource *res;
+	u32 *map_array;
+	int ret, i, count;
+
+	priv->pll_clk = devm_clk_get(dev, "pll");
+	if (IS_ERR(priv->pll_clk))
+		return dev_err_probe(dev, PTR_ERR(priv->pll_clk),
+				     "no pll clock\n");
+
+	priv->mod_clk = devm_clk_get(dev, "mod");
+	if (IS_ERR(priv->mod_clk))
+		return dev_err_probe(dev, PTR_ERR(priv->mod_clk),
+				     "no mod clock\n");
+
+	priv->mcu_mod_clk = devm_clk_get(dev, "mcu-mod");
+	if (IS_ERR(priv->mcu_mod_clk))
+		return dev_err_probe(dev, PTR_ERR(priv->mcu_mod_clk),
+				     "no mcu-mod clock\n");
+
+	priv->cfg_clk = devm_clk_get(dev, "cfg");
+	if (IS_ERR(priv->cfg_clk))
+		return dev_err_probe(dev, PTR_ERR(priv->cfg_clk),
+				     "no cfg clock\n");
+
+	priv->ahbs_clk = devm_clk_get(dev, "ahbs");
+	if (IS_ERR(priv->ahbs_clk))
+		return dev_err_probe(dev, PTR_ERR(priv->ahbs_clk),
+				     "no ahbs clock\n");
+
+	priv->mod_rst = devm_reset_control_get_exclusive(dev, "mod-rst");
+	if (IS_ERR(priv->mod_rst))
+		return dev_err_probe(dev, PTR_ERR(priv->mod_rst),
+				     "no mod-rst reset\n");
+
+	priv->cfg_rst = devm_reset_control_get_exclusive(dev, "cfg-rst");
+	if (IS_ERR(priv->cfg_rst))
+		return dev_err_probe(dev, PTR_ERR(priv->cfg_rst),
+				     "no cfg-rst reset\n");
+
+	priv->dbg_rst = devm_reset_control_get_exclusive(dev, "dbg-rst");
+	if (IS_ERR(priv->dbg_rst))
+		return dev_err_probe(dev, PTR_ERR(priv->dbg_rst),
+				     "no dbg-rst reset\n");
+
+	ret = of_property_read_u32(dev->of_node, "clock-frequency",
+				   &priv->mod_clk_freq);
+	if (ret) {
+		dev_err(dev, "no clock-frequency\n");
+		return ret;
+	}
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM,
+					   "sram-for-cpux");
+	if (!res) {
+		dev_err(dev, "no sram-for-cpux resource\n");
+		return -ENXIO;
+	}
+	priv->sram_remap_reg = devm_ioremap_resource(dev, res);
+	if (IS_ERR(priv->sram_remap_reg))
+		return PTR_ERR(priv->sram_remap_reg);
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM,
+					   "hifi4-cfg");
+	if (!res) {
+		dev_err(dev, "no hifi4-cfg resource\n");
+		return -ENXIO;
+	}
+	priv->hifi4_cfg = devm_ioremap_resource(dev, res);
+	if (IS_ERR(priv->hifi4_cfg))
+		return PTR_ERR(priv->hifi4_cfg);
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sram");
+	if (!res) {
+		dev_err(dev, "no sram resource\n");
+		return -ENXIO;
+	}
+	priv->sram = devm_ioremap_wc(dev, res->start, resource_size(res));
+	if (!priv->sram)
+		return -ENOMEM;
+	priv->sram_size = resource_size(res);
+
+	count = of_property_count_elems_of_size(dev->of_node,
+						"memory-mappings",
+						sizeof(u32) * 3);
+	if (count <= 0) {
+		dev_err(dev, "no memory-mappings\n");
+		return -ENXIO;
+	}
+
+	priv->mem_maps_cnt = count;
+	priv->mem_maps = devm_kcalloc(dev, count, sizeof(*priv->mem_maps),
+				      GFP_KERNEL);
+	if (!priv->mem_maps)
+		return -ENOMEM;
+
+	map_array = devm_kcalloc(dev, count * 3, sizeof(u32), GFP_KERNEL);
+	if (!map_array)
+		return -ENOMEM;
+
+	ret = of_property_read_u32_array(dev->of_node, "memory-mappings",
+					 map_array, count * 3);
+	if (ret) {
+		dev_err(dev, "failed to read memory-mappings\n");
+		return ret;
+	}
+
+	for (i = 0; i < count; i++) {
+		priv->mem_maps[i].da = map_array[i * 3];
+		priv->mem_maps[i].len = map_array[i * 3 + 1];
+		priv->mem_maps[i].pa = map_array[i * 3 + 2];
+	}
+
+	devm_kfree(dev, map_array);
+	return 0;
+}
+
+static int sun55i_hifi4_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct rproc *rproc;
+	struct sun55i_hifi4_rproc *priv;
+	const char *fw_name = NULL;
+	int ret;
+
+	of_property_read_string(dev->of_node, "firmware-name", &fw_name);
+
+	rproc = devm_rproc_alloc(dev, dev_name(dev),
+				 &sun55i_hifi4_rproc_ops,
+				 fw_name, sizeof(*priv));
+	if (!rproc)
+		return -ENOMEM;
+
+	priv = sun55i_rproc_priv(rproc);
+	priv->dev = dev;
+	priv->rproc = rproc;
+
+	ret = sun55i_hifi4_parse_dt(priv);
+	if (ret)
+		return ret;
+
+	rproc->has_iommu = false;
+	rproc->auto_boot = false;
+
+	ret = sun55i_request_mbox(rproc);
+	if (ret)
+		return ret;
+
+	priv->workqueue = alloc_workqueue(dev_name(dev), WQ_UNBOUND, 1);
+	if (!priv->workqueue) {
+		sun55i_free_mbox(rproc);
+		return -ENOMEM;
+	}
+
+	platform_set_drvdata(pdev, rproc);
+
+	ret = devm_rproc_add(dev, rproc);
+	if (ret) {
+		destroy_workqueue(priv->workqueue);
+		sun55i_free_mbox(rproc);
+		return ret;
+	}
+
+	dev_info(dev, "HiFi4 DSP remoteproc ready (fw: %s)\n",
+		 fw_name ? fw_name : "none");
+	return 0;
+}
+
+static void sun55i_hifi4_remove(struct platform_device *pdev)
+{
+	struct rproc *rproc = platform_get_drvdata(pdev);
+	struct sun55i_hifi4_rproc *priv = sun55i_rproc_priv(rproc);
+
+	destroy_workqueue(priv->workqueue);
+	sun55i_free_mbox(rproc);
+}
+
+static const struct of_device_id sun55i_hifi4_rproc_of_match[] = {
+	{ .compatible = "allwinner,hifi4-rproc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sun55i_hifi4_rproc_of_match);
+
+static struct platform_driver sun55i_hifi4_rproc_driver = {
+	.probe	= sun55i_hifi4_probe,
+	.remove	= sun55i_hifi4_remove,
+	.driver	= {
+		.name = "sun55i-hifi4-rproc",
+		.of_match_table = sun55i_hifi4_rproc_of_match,
+	},
+};
+module_platform_driver(sun55i_hifi4_rproc_driver);
+
+MODULE_DESCRIPTION("Allwinner T527/A523 HiFi4 DSP remoteproc driver");
+MODULE_LICENSE("GPL");
