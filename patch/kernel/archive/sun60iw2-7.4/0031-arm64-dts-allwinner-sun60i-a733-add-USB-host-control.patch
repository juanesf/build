From 4036cab5dda00d5b14767d1e3734584fbdd4f6b4 Mon Sep 17 00:00:00 2001
From: Juan Sanchez <juanesf91@gmail.com>
Date: Sun, 15 Nov 2026 03:23:09 -0300
Subject: [PATCH 31/44] arm64: dts: allwinner: sun60i-a733: add USB host
 controllers

The A733 DTSI imported from the patchwork series describes no USB node at
all, so the kernel never creates a single host controller even though
USB_DWC3, USB_XHCI_HCD, USB_EHCI_HCD, USB_OHCI_HCD and PHY_SUN4I_USB are
all built in. Add them using only mainline bindings and drivers.

The USB2 PHY and the EHCI/OHCI pairs follow the mainline A523 DTSI (same
femtoPHY IP), adapted with the A733 interrupt numbers 157-160 from the
vendor reference, the clock/reset IDs from
dt-bindings/clock/allwinner,sun60i-a733-ccu.h and
dt-bindings/reset/allwinner,sun60i-a733-ccu.h, and the A733-specific
"allwinner,sun60i-a733-usb-phy" compatible (with the D1 fallback), which
selects the SIDDQ-before-reset handling added for this SoC.

DWC3 is described with the CCU clocks/resets used by the vendor tree but
without any vendor glue: on this board its USB3 combo PHY is not
populated, so it is limited to high-speed, with the femtoPHY setup left
as programmed by the firmware. A proper DT description of the 0x6b00000
femtoPHY is left for a follow-up.

Enable the nodes on the Cubie A7A with the VBUS regulators already present
in the board DTS (PL2 USB0-DRVVBUS and PM5 USB_HOST_EN, both always-on).

Signed-off-by: Juan Sanchez <juanesf91@gmail.com>
---
 .../dts/allwinner/sun60i-a733-cubie-a7a.dts   | 37 ++++++++
 .../arm64/boot/dts/allwinner/sun60i-a733.dtsi | 91 +++++++++++++++++++
 2 files changed, 128 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
index 977594dc5..cb0aa233d 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -159,6 +159,43 @@ &mmc0 {
 	status = "okay";
 };
 
+&usbphy {
+	usb0_vbus-supply = <&reg_usb0_vbus>;
+	usb1_vbus-supply = <&reg_usb0_vbus>;
+	status = "okay";
+};
+
+&ehci0 {
+	vbus-supply = <&reg_usb0_vbus>;
+	status = "okay";
+};
+
+&ohci0 {
+	vbus-supply = <&reg_usb0_vbus>;
+	status = "okay";
+};
+
+&ehci1 {
+	vbus-supply = <&reg_usb0_vbus>;
+	status = "okay";
+};
+
+&ohci1 {
+	vbus-supply = <&reg_usb0_vbus>;
+	status = "okay";
+};
+
+/*
+ * On the Cubie A7A the DWC3 is wired to the USB 2.0 femtoPHY only; the
+ * USB 3.0 combo PHY is not used. Sheet 14 of the v1.10 schematic shows
+ * the USB 3.0/2.0 hub (and, through its port 4, the AIC8800 WiFi module)
+ * downstream of this path.
+ */
+&dwc3 {
+	dr_mode = "host";
+	status = "okay";
+};
+
 &osc {
 	clock-frequency = <24000000>;
 };
diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index d0b9f432e..8b9a41b6a 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -483,6 +483,97 @@ mmc2: mmc@4022000 {
 			status = "disabled";
 		};
 
+		usbphy: phy@4100400 {
+			compatible = "allwinner,sun60i-a733-usb-phy",
+				     "allwinner,sun20i-d1-usb-phy";
+			reg = <0x04100400 0x100>,
+			      <0x04101800 0x100>,
+			      <0x04200800 0x100>;
+			reg-names = "phy_ctrl", "pmu0", "pmu1";
+			clocks = <&osc>, <&osc>;
+			clock-names = "usb0_phy", "usb1_phy";
+			resets = <&ccu RST_USB_PHY0>,
+				 <&ccu RST_USB_PHY1>;
+			reset-names = "usb0_reset", "usb1_reset";
+			#phy-cells = <1>;
+			status = "disabled";
+		};
+
+		ehci0: usb@4101000 {
+			compatible = "allwinner,sun55i-a523-ehci",
+				     "generic-ehci";
+			reg = <0x04101000 0x100>;
+			interrupts = <GIC_SPI 157 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_OHCI0>,
+				 <&ccu CLK_BUS_EHCI0>,
+				 <&ccu CLK_USB_OHCI0>;
+			resets = <&ccu RST_BUS_OHCI0>,
+				 <&ccu RST_BUS_EHCI0>;
+			phys = <&usbphy 0>;
+			phy-names = "usb";
+			status = "disabled";
+		};
+
+		ohci0: usb@4101400 {
+			compatible = "allwinner,sun55i-a523-ohci",
+				     "generic-ohci";
+			reg = <0x04101400 0x100>;
+			interrupts = <GIC_SPI 158 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_OHCI0>,
+				 <&ccu CLK_USB_OHCI0>;
+			resets = <&ccu RST_BUS_OHCI0>;
+			phys = <&usbphy 0>;
+			phy-names = "usb";
+			status = "disabled";
+		};
+
+		ehci1: usb@4200000 {
+			compatible = "allwinner,sun55i-a523-ehci",
+				     "generic-ehci";
+			reg = <0x04200000 0x100>;
+			interrupts = <GIC_SPI 159 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_OHCI1>,
+				 <&ccu CLK_BUS_EHCI1>,
+				 <&ccu CLK_USB_OHCI1>;
+			resets = <&ccu RST_BUS_OHCI1>,
+				 <&ccu RST_BUS_EHCI1>;
+			phys = <&usbphy 1>;
+			phy-names = "usb";
+			status = "disabled";
+		};
+
+		ohci1: usb@4200400 {
+			compatible = "allwinner,sun55i-a523-ohci",
+				     "generic-ohci";
+			reg = <0x04200400 0x100>;
+			interrupts = <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_OHCI1>,
+				 <&ccu CLK_USB_OHCI1>;
+			resets = <&ccu RST_BUS_OHCI1>;
+			phys = <&usbphy 1>;
+			phy-names = "usb";
+			status = "disabled";
+		};
+
+		dwc3: usb@6a00000 {
+			compatible = "snps,dwc3";
+			reg = <0x06a00000 0x10000>;
+			interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_OTG>,
+				 <&ccu CLK_USB2_U2_REF>,
+				 <&ccu CLK_USB2_SUSPEND>;
+			clock-names = "bus_early", "ref", "suspend";
+			assigned-clocks = <&ccu CLK_USB2_SUSPEND>;
+			assigned-clock-rates = <24000000>;
+			resets = <&ccu RST_BUS_OTG>, <&ccu RST_BUS_USB2>;
+			reset-names = "bus", "dwc3";
+			maximum-speed = "high-speed";
+			dr_mode = "host";
+			snps,dis_u2_susphy_quirk;
+			snps,dis_u3_susphy_quirk;
+			status = "disabled";
+		};
+
 		r_ccu: clock-controller@7010000 {
 			compatible = "allwinner,sun60i-a733-r-ccu";
 			reg = <0x07010000 0x250>;
-- 
