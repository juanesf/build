From 6e0910c2cb6703bf6e13b03f5ffe6d4f562d0863 Mon Sep 17 00:00:00 2001
From: Juan Sanchez <juanesf91@gmail.com>
Date: Sun, 15 Nov 2026 17:51:56 -0300
Subject: [PATCH 53/56] arm64: dts: allwinner: cubie-a7a: describe the eMMC
 supplies

The SoC DTSI imported from patchwork leaves mmc2 without vmmc/vqmmc
supplies, so mmc_regulator_set_ocr() leaves host->ocr_avail empty and the
eMMC fails with "no support for card's volts" / error -22.

Describe them as on the 7.2 vendor port: ALDO5 ("vcc-emmc", 3.3 V) for
vmmc and CLDO5 ("vcc18-pf-pc", 1.8 V) for vqmmc, matching the 1.8 V
HS200 mode. Both regulators exist in the AXP318W driver. The eMMC is
only detected, never mounted or written by this image.

Signed-off-by: Juan Sanchez <juanesf91@gmail.com>
---
 arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
index 9e8183991..a7a9b21df 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -346,6 +346,13 @@ reg_aldo1: aldo1 {
 				regulator-always-on;
 			};
 
+			reg_aldo5: aldo5 {
+				regulator-name = "vcc-emmc";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+			};
+
 			reg_bldo1: bldo1 {
 				regulator-name = "vcc-pe-pk-mcsi";
 			};
@@ -440,6 +447,8 @@ &uart0 {
 };
 
 &mmc2 {
+	vmmc-supply = <&reg_aldo5>;
+	vqmmc-supply = <&reg_cldo5>;
 	bus-width = <8>;
 	cap-mmc-highspeed;
 	mmc-hs200-1_8v;
