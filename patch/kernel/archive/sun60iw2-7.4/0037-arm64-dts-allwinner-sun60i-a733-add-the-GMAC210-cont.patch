From 570e19012e71cb4ecb5c747950ada82f60591221 Mon Sep 17 00:00:00 2001
From: Juan Sanchez <juanesf91@gmail.com>
Date: Sun, 15 Nov 2026 13:27:11 -0300
Subject: [PATCH 37/43] arm64: dts: allwinner: sun60i-a733: add the GMAC210
 controller

Add the Gigabit Ethernet controller to the A733 SoC DTSI and enable it on
the Radxa Cubie A7A. The node follows the Allwinner A733 GMAC210 binding
added by the preceding patch series (dwmac-sun55i): the glue registers are
a dedicated MMIO region instead of a syscon, there are four interrupt
lines, a PTP reference clock and an AHB reset.

Interrupt numbers come from the A733 User Manual V0.92, table 12-1:
GMAC0_TOP=204, GMAC0_PERCH_TX_0=205, GMAC0_PERCH_RX_0=206 and
GMAC0_PWS_CLK_CTRL=210; GIC SPI numbers are INT-32 (172/173/174/178).
U-Boot uses a single legacy IRQ 68 for its dwc-qos-ethernet-4.10 node,
which does not match the dwmac-5.20 multi-MSI layout.

The RGMII pins (PH0-PH15, mux 5), the delays (2160/1800 ps, multiples of
the 180 ps step), the PHY at MDIO address 1 and its reset GPIO (PH16) are
taken from the v1.10 schematic and the working 7.2 board description.

Signed-off-by: Juan Sanchez <juanesf91@gmail.com>
---
 .../dts/allwinner/sun60i-a733-cubie-a7a.dts   | 27 +++++++++++++
 .../arm64/boot/dts/allwinner/sun60i-a733.dtsi | 38 +++++++++++++++++++
 2 files changed, 65 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
index cb0aa233d..01a8815c6 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -159,6 +159,33 @@ &mmc0 {
 	status = "okay";
 };
 
+&gmac0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&gmac0_rgmii_pins>;
+	phy-mode = "rgmii";
+	phy-handle = <&ext_rgmii_phy>;
+	phy-supply = <&reg_swout1>;
+	/* 180 ps delay steps: 2160 = 12 x 180, 1800 = 10 x 180. */
+	tx-internal-delay-ps = <2160>;
+	rx-internal-delay-ps = <1800>;
+	status = "okay";
+
+	mdio {
+		compatible = "snps,dwmac-mdio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		ext_rgmii_phy: ethernet-phy@1 {
+			compatible = "ethernet-phy-id7b74.4412",
+				     "ethernet-phy-ieee802.3-c22";
+			reg = <1>;
+			reset-gpios = <&pio 7 16 GPIO_ACTIVE_LOW>; /* PH16 */
+			reset-assert-us = <10000>;
+			reset-deassert-us = <150000>;
+		};
+	};
+};
+
 &usbphy {
 	usb0_vbus-supply = <&reg_usb0_vbus>;
 	usb1_vbus-supply = <&reg_usb0_vbus>;
diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index 8b9a41b6a..452624c68 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -144,6 +144,17 @@ mmc2_pins: mmc2-pins {
 				bias-pull-up;
 			};
 
+			gmac0_rgmii_pins: gmac0-rgmii-pins {
+				pins = "PH0", "PH1", "PH2", "PH3",
+				       "PH4", "PH5", "PH6", "PH7",
+				       "PH8", "PH9", "PH10", "PH11",
+				       "PH12", "PH13", "PH14", "PH15";
+				function = "gmac0";
+				allwinner,pinmux = <5>;
+				drive-strength = <40>;
+				bias-pull-up;
+			};
+
 			uart0_pb_pins: uart0-pb-pins {
 				pins = "PB9", "PB10";
 				function = "uart0";
@@ -483,6 +494,33 @@ mmc2: mmc@4022000 {
 			status = "disabled";
 		};
 
+		gmac0: ethernet@4500000 {
+			compatible = "allwinner,sun60i-a733-gmac210",
+				     "snps,dwmac-5.20";
+			reg = <0x04500000 0x8000>,
+			      <0x04508000 0x1000>;
+			/* A733 User Manual table 12-1: INT 204/205/206/210 - 32 */
+			interrupts = <GIC_SPI 172 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "macirq", "eth_lpi",
+					  "tx-queue-0", "rx-queue-0";
+			clocks = <&ccu CLK_BUS_GMAC0>,
+				 <&ccu CLK_MBUS_GMAC0>,
+				 <&ccu CLK_GMAC_PTP>;
+			clock-names = "stmmaceth", "mbus", "ptp_ref";
+			resets = <&ccu RST_BUS_GMAC0_AXI>,
+				 <&ccu RST_BUS_GMAC0>;
+			reset-names = "stmmaceth", "ahb";
+			status = "disabled";
+
+			mdio0: mdio {
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
+		};
+
 		usbphy: phy@4100400 {
 			compatible = "allwinner,sun60i-a733-usb-phy",
 				     "allwinner,sun20i-d1-usb-phy";
-- 
2.53.0

