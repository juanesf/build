From e1fe9be849e1eba417ac0c3dc893e0614bf2381a Mon Sep 17 00:00:00 2001
From: Juan Sanchez <juanesf91@gmail.com>
Date: Sun, 15 Nov 2026 21:07:48 -0300
Subject: [PATCH 40/44] arm64: dts: allwinner: sun60i-a733: describe the U2P0
 PHY and wire DWC3

Add the dedicated USB2 femtoPHY node and reference it from dwc3 with
phy-names = "usb2-phy". Port the working DWC3 configuration from the
vendor BSP (5.15.147-a733): 1 MiB register window, phy_type = "utmi",
and the snps,dis-* quirks. Keep high-speed mode: the USB3 combo PHY is
not described on this board.

The generic sun4i-usb-phy keeps its two EHCI/OHCI PHYs; it is no longer
asked to own the U2P0 window. fw_devlink now makes DWC3 wait for the
U2P0 PHY. The PHY programming itself is done in phy_power_on(), i.e.
after the DWC3 core soft reset and before xHCI starts enumerating.

Signed-off-by: Juan Sanchez <juanesf91@gmail.com>
---
 .../dts/allwinner/sun60i-a733-cubie-a7a.dts   |  4 ++++
 .../arm64/boot/dts/allwinner/sun60i-a733.dtsi | 20 ++++++++++++++++++-
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
index ffcc030b5..e90821807 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -223,6 +223,10 @@ &ohci1 {
  * the USB 3.0/2.0 hub (and, through its port 4, the AIC8800 WiFi module)
  * downstream of this path.
  */
+&u2phy {
+	status = "okay";
+};
+
 &dwc3 {
 	dr_mode = "host";
 	status = "okay";
diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index 452624c68..3ca8803b1 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -521,6 +521,18 @@ mdio0: mdio {
 			};
 		};
 
+		u2phy: phy@6b00000 {
+			compatible = "allwinner,sun60i-a733-u2phy";
+			reg = <0x06b00000 0x800>,
+			      <0x03000000 0x300>,
+			      <0x06c00000 0x400>;
+			reg-names = "u2_base", "res_base", "serdes";
+			clocks = <&ccu CLK_RES_DCAP_24M>;
+			clock-names = "res_dcap";
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
 		usbphy: phy@4100400 {
 			compatible = "allwinner,sun60i-a733-usb-phy",
 				     "allwinner,sun20i-d1-usb-phy";
@@ -595,7 +607,7 @@ ohci1: usb@4200400 {
 
 		dwc3: usb@6a00000 {
 			compatible = "snps,dwc3";
-			reg = <0x06a00000 0x10000>;
+			reg = <0x06a00000 0x100000>;
 			interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&ccu CLK_BUS_OTG>,
 				 <&ccu CLK_USB2_U2_REF>,
@@ -607,6 +619,12 @@ dwc3: usb@6a00000 {
 			reset-names = "bus", "dwc3";
 			maximum-speed = "high-speed";
 			dr_mode = "host";
+			phys = <&u2phy>;
+			phy-names = "usb2-phy";
+			phy_type = "utmi";
+			snps,dis_enblslpm_quirk;
+			snps,dis-u1-entry-quirk;
+			snps,dis-u2-entry-quirk;
 			snps,dis_u2_susphy_quirk;
 			snps,dis_u3_susphy_quirk;
 			status = "disabled";
-- 
