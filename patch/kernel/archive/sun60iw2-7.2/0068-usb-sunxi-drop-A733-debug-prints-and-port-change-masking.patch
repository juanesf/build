From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juanesf <juanesf91@users.noreply.github.com>
Date: Fri, 13 Nov 2026 00:00:00 +0000
Subject: [PATCH] usb: sunxi: drop A733 debug prints and vendor port-change masking

The A733 bring-up inherited two things from the vendor series that the
mainline driver does not need:

  - diagnostic dev_info() lines in dwc3/core.c that dump GSNPSID, LLUCTL,
    the CCU words and the PPU state on every probe, and an xhci_info() in
    xhci-hub.c for every port change bit, which floods dmesg every 100 ms
    once a device is connected;
  - the A733-specific `cleared_change_bits` port workaround.  It masks CSC
    and PRC in xhci_get_port_status() and xhci_hub_status_data(), so hub_wq
    can miss the connect/reset changes it is supposed to react to, and it
    special-cases USB_PORT_FEAT_RESET to issue a warm reset on USB3.  This
    board uses the controller as a USB2-only host (combo0 is not brought
    up), where mainline's unmodified port handling is correct.

Drop the field from struct xhci_port and all five conditional blocks.  The
clock/reset bring-up itself is unchanged.

Signed-off-by: Juanesf <juanesf91@users.noreply.github.com>
---
 drivers/usb/dwc3/core.c | 11 -----------
 drivers/usb/host/xhci-hub.c | 42 +----------------------------------------
 drivers/usb/host/xhci.h | 1 -
 3 files changed

diff --git a/drivers/usb/dwc3/core.c b/drivers/usb/dwc3/core.c
--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -1010,7 +1010,6 @@
 	u32 reg;
 
 	reg = dwc3_readl(dwc, DWC3_GSNPSID);
-	dev_info(dwc->dev, "[DWC3-DIAG] DWC3_GSNPSID (0xc120) = 0x%08x\n", reg);
 	dwc->ip = DWC3_GSNPS_ID(reg);
 	if (dwc->ip == DWC4_IP)
 		dwc->ip = DWC32_IP;
@@ -1535,8 +1534,6 @@
 			if (dwc->maximum_speed == USB_SPEED_SUPER)
 				reg |= DWC3_LLUCTL_FORCE_GEN1;
 			dwc3_writel(dwc, DWC3_LLUCTL(i), reg);
-			dev_info(dwc->dev, "[DWC3-DIAG] DWC3_LLUCTL(%d) = 0x%08x\n",
-				 i, dwc3_readl(dwc, DWC3_LLUCTL(i)));
 		}
 	}
 
@@ -2410,10 +2407,6 @@
 			val = readl(ccu_base + 0x13c4);
 			writel(val | 0x00010001, ccu_base + 0x13c4);
 
-			dev_info(dev, "[CCU-DIAG] 0x5c0=0x%08x 0x5e0=0x%08x 0x3354=0x%08x 0x335c=0x%08x 0x1a00=0x%08x\n",
-				 readl(ccu_base + 0x05c0), readl(ccu_base + 0x05e0),
-				 readl(ccu_base + 0x1354), readl(ccu_base + 0x135C),
-				 readl(ccu_base + 0x1a00));
 			iounmap(ccu_base);
 		}
 
@@ -2433,8 +2426,6 @@
 		if (subsys_base) {
 			writel(0x00030010, subsys_base + 0x0008);
 			writel(0x20000000, subsys_base + 0x00F0); /* debug test mux off */
-			dev_info(dev, "[DWC3-SUBSYS-MMIO] 0x06c00008=0x%08x 0x06c000f0=0x%08x\n",
-				 readl(subsys_base + 0x0008), readl(subsys_base + 0x00F0));
 			iounmap(subsys_base);
 		}
 
@@ -2470,8 +2461,6 @@
 				writel(0x8, ccu_base + 0x0000);
 				usleep_range(1000, 2000);
 			}
-			dev_info(dev, "[DWC3-PPU] USB2 status=0x%08x\n",
-				 readl(ccu_base + 0x0008));
 			iounmap(ccu_base);
 		}
 	}
diff --git a/drivers/usb/host/xhci-hub.c b/drivers/usb/host/xhci-hub.c
--- a/drivers/usb/host/xhci-hub.c
+++ b/drivers/usb/host/xhci-hub.c
@@ -624,14 +624,6 @@
 	xhci_portsc_writel(port, portsc | status);
 	portsc = xhci_portsc_readl(port);
 
-#ifdef CONFIG_ARCH_SUNXI
-	if (of_machine_is_compatible("allwinner,sun60i-a733")) {
-		port->cleared_change_bits |= status;
-		xhci_info(xhci, "[SUNXI-A733] Port %d cleared_change_bits=0x%08x (added 0x%x)\n",
-			  port->hcd_portnum + 1, port->cleared_change_bits, status);
-	}
-#endif
-
 	xhci_dbg(xhci, "clear port%d %s change, portsc: 0x%x\n",
 		 port->hcd_portnum + 1, port_change_bit, portsc);
 }
@@ -1153,15 +1145,6 @@
 	rhub = xhci_get_rhub(hcd);
 	port = rhub->ports[portnum];
 
-#ifdef CONFIG_ARCH_SUNXI
-	if (of_machine_is_compatible("allwinner,sun60i-a733")) {
-		if (!(portsc & PORT_CONNECT) || (portsc & PORT_PLS_MASK) > XDEV_U2)
-			port->cleared_change_bits = 0;
-		else
-			portsc &= ~port->cleared_change_bits;
-	}
-#endif
-
 	/* common wPortChange bits */
 	if (portsc & PORT_CSC)
 		status |= USB_PORT_STAT_C_CONNECTION << 16;
@@ -1484,17 +1467,7 @@
 			xhci_set_port_power(xhci, port, true, &flags);
 			break;
 		case USB_PORT_FEAT_RESET:
-#ifdef CONFIG_ARCH_SUNXI
-			if (of_machine_is_compatible("allwinner,sun60i-a733")) {
-				port->cleared_change_bits &= ~PORT_RC;
-				if (hcd->speed >= HCD_USB3 &&
-				    (portsc & PORT_PLS_MASK) != XDEV_U0)
-					portsc |= PORT_WR;
-				else
-					portsc |= PORT_RESET;
-			} else
-#endif
-				portsc |= PORT_RESET;
+			portsc |= PORT_RESET;
 			xhci_portsc_writel(port, portsc);
 
 			portsc = xhci_portsc_readl(port);
@@ -1509,10 +1482,6 @@
 				 hcd->self.busnum, portnum + 1, portsc);
 			break;
 		case USB_PORT_FEAT_BH_PORT_RESET:
-#ifdef CONFIG_ARCH_SUNXI
-			if (of_machine_is_compatible("allwinner,sun60i-a733"))
-				port->cleared_change_bits &= ~PORT_WRC;
-#endif
 			portsc |= PORT_WR;
 			xhci_portsc_writel(port, portsc);
 			portsc = xhci_portsc_readl(port);
@@ -1693,15 +1662,6 @@
 		}
 		trace_xhci_hub_status_data(ports[i], temp);
 
-#ifdef CONFIG_ARCH_SUNXI
-		if (of_machine_is_compatible("allwinner,sun60i-a733")) {
-			if (!(temp & PORT_CONNECT) || (temp & PORT_PLS_MASK) > XDEV_U2)
-				ports[i]->cleared_change_bits = 0;
-			else
-				temp &= ~ports[i]->cleared_change_bits;
-		}
-#endif
-
 		if ((temp & mask) != 0 ||
 			(bus_state->port_c_suspend & 1 << i) ||
 			(ports[i]->resume_timestamp && time_after_eq(
diff --git a/drivers/usb/host/xhci.h b/drivers/usb/host/xhci.h
--- a/drivers/usb/host/xhci.h
+++ b/drivers/usb/host/xhci.h
@@ -1488,7 +1488,6 @@
 	struct completion	rexit_done;
 	struct completion	u3exit_done;
 #ifdef CONFIG_ARCH_SUNXI
-	u32			cleared_change_bits;
 #endif
 };
 
