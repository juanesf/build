       - allwinner,sun20i-d1-tcon-top
       - allwinner,sun50i-h6-tcon-top
       - allwinner,sun50i-h616-tcon-top
+      - allwinner,sun55i-a523-tcon-top
+      - allwinner,sun55i-a523-tcon-top1
 
   reg:
     maxItems: 1
 
   clocks:
-    minItems: 2
+    minItems: 1
     maxItems: 6
 
   clock-names:
-    minItems: 2
+    minItems: 1
     maxItems: 6
 
   clock-output-names:
@@ -63,6 +65,9 @@ properties:
   resets:
     maxItems: 1
 
+  power-domains:
+    maxItems: 1
+
   ports:
     $ref: /schemas/graph.yaml#/properties/ports
 
@@ -104,18 +109,27 @@ properties:
       - port@5
 
