-  - ports
 
 additionalProperties: false
 
 allOf:
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              const: allwinner,sun55i-a523-tcon-top1
+    then:
+      required:
+        - "#clock-cells"
+        - clock-output-names
+        - ports
+
   - if:
       properties:
         compatible:
@@ -234,6 +248,62 @@ allOf:
             - port@2
             - port@3
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: allwinner,sun55i-a523-tcon-top
+
+    then:
+      properties:
+        clocks:
+          items:
+            - description: The TCON TOP interface clock
+            - description: The TCON TOP TV0 clock
+            - description: The TCON TOP TV1 clock
+            - description: The TCON TOP MIPI DSI clock
+
+        clock-names:
+          items:
+            - const: bus
+            - const: tcon-tv0
+            - const: tcon-tv1
+            - const: dsi
+
+        clock-output-names:
+          items:
+            - description: TCON TV0 output clock name
+            - description: TCON TV1 output clock name
+            - description: DSI output clock name
+
+        ports:
+          required:
+            - port@2
+            - port@3
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: allwinner,sun55i-a523-tcon-top1
+
+    then:
+      properties:
+        clocks:
+          minItems: 1
+          items:
+            - description: The TCON TOP interface clock
+
+        clock-names:
+          minItems: 1
+          items:
+            - const: bus
+
+        clock-output-names: false
+        ports: false
+      required:
+        - power-domains
+
 examples:
   - |
     #include <dt-bindings/interrupt-controller/arm-gic.h>
-- 
