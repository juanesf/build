From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Armbian <armbian@localhost>
Date: Tue, 22 Sep 2026 22:50:00 -0300
Subject: [PATCH] arm64: dts: allwinner: t527: Enable HDMI on OrangePi 4A

Now that the A523 display pipeline is wired up, enable the HDMI output on
the OrangePi 4A by adding reserved memory for the secure monitor, an HDMI
connector, a CMA pool and the HDMI PHY supply, following the Radxa Cubie
A5E example.

Signed-off-by: Armbian <armbian@localhost>
---
 arch/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts | 98 ++++++++++----
 1 file changed

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
index 055be86e5fae00519ac64b76a1aeeb1c42c92d15..adba4a5753058ae903a804ca36924484e6ef15cc 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
@@ -23,6 +23,52 @@
 		stdout-path = "serial0:115200n8";
 	};
 
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* 128 KiB reserved for Trusted Firmware-A (BL31). */
+		secmon@48000000 {
+			reg = <0x0 0x48000000 0x0 0x20000>;
+			no-map;
+		};
+
+		/* 256 KiB reserved for the SCP. */
+		secmon@48100000 {
+			reg = <0x0 0x48100000 0x0 0x40000>;
+			no-map;
+		};
+
+		/*
+		 * The display engine's layer DMA master has a limited fetch
+		 * aperture and can only reach low DRAM (it reads the RCQ pool at
+		 * ~0x43000000 but not 0x4b100000). The kernel's default CMA is
+		 * high (~0xf0000000), so scanout fetches zeros (black). Ideally
+		 * this pool should be pinned low just above the kernel image
+		 * (ends ~0x42c70000) and the RCQ pool (~0x43000000), below the
+		 * dtb (~0x49ff6000); that is NOT guaranteed without reg and
+		 * alloc-ranges. HDMI output on this board is untested.
+		 */
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x0 0x10000000>;
+			linux,cma-default;
+		};
+	};
+
 	ext_osc32k: ext-osc32k-clk {
 		#clock-cells = <0>;
 		compatible = "fixed-clock";
@@ -95,6 +141,10 @@
 	};
 };
 
+&de {
+	status = "okay";
+};
+
 &ehci0 {
 	status = "okay";
 };
@@ -119,6 +169,17 @@
 	status = "okay";
 };
 
+&hdmi {
+	hvcc-supply = <&reg_cldo1>;
+	status = "okay";
+};
+
+&hdmi_out {
+	hdmi_out_con: endpoint {
+		remote-endpoint = <&hdmi_con_in>;
+	};
+};
+
 &mdio1 {
 	ext_rgmii_phy: ethernet-phy@1 {
 		compatible = "ethernet-phy-ieee802.3-c22";

-- 
2.53.0
