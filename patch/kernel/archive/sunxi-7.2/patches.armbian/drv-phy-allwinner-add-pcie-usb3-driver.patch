Subject: phy: allwinner: add A523/T527 USB3/PCIe combo PHY driver

Signed-off-by: Marvin Wewer <mwewer37@proton.me>
---
 drivers/phy/allwinner/Kconfig               |   10 +
 drivers/phy/allwinner/Makefile              |    1 +
 drivers/phy/allwinner/phy-sun55i-combophy.c |  520 ++++++++++
 3 files changed, 531 insertions(+)

diff --git a/drivers/phy/allwinner/Kconfig b/drivers/phy/allwinner/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/phy/allwinner/Kconfig
+++ b/drivers/phy/allwinner/Kconfig
@@ -67,3 +67,13 @@ config AC200_PHY_CTL
 	  Enable this to support the Ethernet PHY operation of the AC200
 	  mixed signal chip. This driver just enables and configures the
 	  PHY, the PHY itself is supported by a standard driver.
+  
+config PHY_SUN55I_COMBOPHY
+	tristate "Allwinner A523/A527/T527 USB3/PCIe combo PHY Driver"
+	depends on ARCH_SUNXI || COMPILE_TEST
+	depends on HAS_IOMEM && COMMON_CLK
+	select GENERIC_PHY
+	help
+	  Enable this to support the Allwinner A523/A527/T527 USB3.0/PCIe
+	  combo PHY using the Innosilicon IP block. The two controllers share
+	  the same lanes and can only be used one at a time.
diff --git a/drivers/phy/allwinner/Makefile b/drivers/phy/allwinner/Makefile
index 111111111111..222222222222 100644
--- a/drivers/phy/allwinner/Makefile
+++ b/drivers/phy/allwinner/Makefile
@@ -4,3 +4,4 @@ obj-$(CONFIG_PHY_SUN6I_MIPI_DPHY)	+= phy-sun6i-mipi-dphy.o
 obj-$(CONFIG_PHY_SUN9I_USB)		+= phy-sun9i-usb.o
 obj-$(CONFIG_PHY_SUN50I_USB3)		+= phy-sun50i-usb3.o
 obj-$(CONFIG_AC200_PHY_CTL)		+= ac200-ephy-ctl.o
+obj-$(CONFIG_PHY_SUN55I_COMBOPHY)	+= phy-sun55i-combophy.o
diff --git a/drivers/phy/allwinner/phy-sun55i-combophy.c b/drivers/phy/allwinner/phy-sun55i-combophy.c
new file mode 100644
index 000000000000..111111111111 100644
--- /dev/null
+++ b/drivers/phy/allwinner/phy-sun55i-combophy.c
@@ -0,0 +1,534 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Allwinner A523/T527 Innosilicon USB3.0/PCIe combo PHY driver
+ *
+ * The combo PHY provides a single lane that is shared between the PCIe
+ * controller and the USB3 controller; only one of them can use the lane
+ * at any given time. The consumer selects the intended use through the
+ * single phy-cell argument, PHY_TYPE_PCIE or PHY_TYPE_USB3, as defined
+ * in include/dt-bindings/phy/phy.h.
+ *
+ * Register programming is derived from the Allwinner BSP driver
+ * (Copyright (C) 2022 Allwinner Electronics Co., Ltd.) and from the
+ * A523 USB3 enablement series by Mikhail Kalashnikov.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/phy/phy.h>
+#include <linux/reset.h>
+#include <linux/units.h>
+
+#include <dt-bindings/phy/phy.h>
+
+/* PCIe/USB3 sub-system control registers */
+#define PCIE_BGR			0x04
+#define  PCIE_ACLK_EN			BIT(17)
+#define  PCIE_HCLK_EN			BIT(16)
+#define  PCIE_PERSTN			BIT(1)
+#define  PCIE_PW_UP_RSTN		BIT(0)
+#define  PCIE_BGR_ENABLE_MASK		(PCIE_ACLK_EN | PCIE_HCLK_EN | \
+					 PCIE_PERSTN | PCIE_PW_UP_RSTN)
+
+#define USB3_BGR			0x08
+#define  USB3_ACLK_EN			BIT(17)
+#define  USB3_HCLK_EN			BIT(16)
+#define  USB3_RESETN			BIT(0)
+#define  USB3_BGR_ENABLE_MASK		(USB3_ACLK_EN | USB3_HCLK_EN | \
+					 USB3_RESETN)
+
+#define PHYCTL				0x10
+#define  PHY_USE_SEL			BIT(31)	/* 0: PCIe, 1: USB3 */
+#define  PHY_CLK_SEL			BIT(30)	/* 0: internal, 1: external */
+#define  PHY_PIPE_SW_SEL		GENMASK(9, 8)
+#define  PHY_RSTN			BIT(0)
+
+struct sun55i_combphy {
+	struct device *dev;
+	struct phy *phy;
+	void __iomem *ctl;		/* sub-system control registers */
+	void __iomem *base;		/* combo PHY analog registers */
+	struct clk *ref_clk;		/* "phyclk_ref" */
+	struct clk *ref_parent;		/* "refclk_par" */
+	struct reset_control *reset;	/* "phy_rst" */
+	u32 mode;			/* PHY_TYPE_* set by the consumer */
+	bool initialized;
+};
+
+static void sun55i_combphy_rmw(void __iomem *addr, u32 clear, u32 set)
+{
+	u32 val;
+
+	val = readl(addr);
+	val &= ~clear;
+	val |= set;
+	writel(val, addr);
+}
+
+/*
+ * Analog tuning of the USB3 PHY. The Innosilicon register map is not
+ * public; the register offsets and values below come from the vendor
+ * BSP and must be treated as opaque.
+ */
+static void sun55i_combphy_usb3_tune(struct sun55i_combphy *priv, bool on)
+{
+	void __iomem *base = priv->base;
+	u32 val;
+
+	/* TX swing/de-emphasis bypass. */
+	if (on)
+		sun55i_combphy_rmw(base + 0x1418, GENMASK(17, 16), BIT(25));
+	else
+		sun55i_combphy_rmw(base + 0x1418, BIT(25), GENMASK(17, 16));
+
+	/* rx_eq_bypass[3]: bypass RX equalization. */
+	if (on)
+		sun55i_combphy_rmw(base + 0x0674, 0, BIT(3));
+	else
+		sun55i_combphy_rmw(base + 0x0674, BIT(3), 0);
+
+	/* rx_ctle_res_cal = 0xf. */
+	if (on)
+		sun55i_combphy_rmw(base + 0x0704, 0, GENMASK(9, 8) | BIT(11));
+	else
+		sun55i_combphy_rmw(base + 0x0704, GENMASK(9, 8) | BIT(11), 0);
+
+	/* CDR divider fine gain adjustments. */
+	if (on)
+		sun55i_combphy_rmw(base + 0x0400, 0, BIT(4));
+	else
+		sun55i_combphy_rmw(base + 0x0400, BIT(4), 0);
+
+	if (on)
+		sun55i_combphy_rmw(base + 0x0404, 0, GENMASK(3, 0) | BIT(5));
+	else
+		sun55i_combphy_rmw(base + 0x0404, GENMASK(3, 0) | BIT(5), 0);
+
+	if (on)
+		sun55i_combphy_rmw(base + 0x0408, 0, BIT(5));
+	else
+		sun55i_combphy_rmw(base + 0x0408, BIT(5), 0);
+
+	if (on)
+		sun55i_combphy_rmw(base + 0x109c, 0, BIT(1));
+	else
+		sun55i_combphy_rmw(base + 0x109c, BIT(1), 0);
+
+	/*
+	 * Spread spectrum clocking: divider N, modulation frequency
+	 * divider and spreading amplitude (400 * 9 = 4410 ppm), with
+	 * down-spreading selected.
+	 */
+	val = readl(base + 0x107c);
+	val &= ~GENMASK(17, 12);
+	val |= BIT(12);
+	writel(val, base + 0x107c);
+
+	val = readl(base + 0x1020);
+	val &= ~GENMASK(4, 0);
+	val |= 0x6;
+	writel(val, base + 0x1020);
+
+	val = readl(base + 0x1034);
+	val &= ~GENMASK(22, 16);
+	val |= 0x9 << 16;
+	writel(val, base + 0x1034);
+
+	if (on)
+		sun55i_combphy_rmw(base + 0x101c, BIT(28), BIT(27));
+	else
+		sun55i_combphy_rmw(base + 0x101c, 0, BIT(27) | BIT(28));
+}
+
+/*
+ * Analog tuning for PCIe operation with a 100 MHz internal reference
+ * clock. The Innosilicon register map is not public; the register
+ * offsets and values below come from the vendor BSP.
+ */
+static void sun55i_combphy_pcie_tune(struct sun55i_combphy *priv)
+{
+	void __iomem *base = priv->base;
+	u32 val;
+
+	/* Reference clock and PLL configuration. */
+	val = readl(base + 0x1004);
+	val &= ~(GENMASK(4, 3) | BIT(0));
+	val |= BIT(0) | BIT(2) | BIT(4);
+	writel(val, base + 0x1004);
+
+	val = readl(base + 0x1018);
+	val |= GENMASK(5, 4);
+	writel(val, base + 0x1018);
+
+	val = readl(base + 0x101c);
+	val &= ~GENMASK(27, 0);
+	writel(val, base + 0x101c);
+
+	/* SSC/jitter optimization parameters. */
+	val = readl(base + 0x107c);
+	val &= ~GENMASK(17, 0);
+	val |= 0x2 << 12 | 0x32;
+	writel(val, base + 0x107c);
+
+	val = readl(base + 0x1030);
+	val &= ~GENMASK(21, 20);
+	writel(val, base + 0x1030);
+
+	val = readl(base + 0x1050);
+	val &= ~GENMASK(7, 5);
+	val |= BIT(5);
+	writel(val, base + 0x1050);
+
+	val = readl(base + 0x1054);
+	val &= ~GENMASK(7, 5);
+	val |= BIT(5);
+	writel(val, base + 0x1054);
+
+	/* TX leg current and de-emphasis. */
+	val = readl(base + 0x0804);
+	val &= ~GENMASK(7, 4);
+	val |= 0xc << 4;
+	writel(val, base + 0x0804);
+
+	val = readl(base + 0x109c);
+	val &= ~GENMASK(9, 8);
+	val |= BIT(1);
+	writel(val, base + 0x109c);
+
+	writel(0x80540a0a, base + 0x1418);
+}
+
+/* Power up the lane for the selected consumer and release the PHY reset. */
+static void sun55i_combphy_subsys_enable(struct sun55i_combphy *priv)
+{
+	u32 clear, set;
+
+	if (priv->mode == PHY_TYPE_USB3) {
+		clear = PHY_CLK_SEL;
+		set = PHY_RSTN | PHY_USE_SEL;
+	} else {
+		clear = PHY_CLK_SEL | PHY_USE_SEL;
+		set = PHY_RSTN;
+	}
+
+	/* Lane user, internal reference clock and PHY reset. */
+	sun55i_combphy_rmw(priv->ctl + PHYCTL, clear, set);
+
+	/* Bus gating and power-up resets of the selected sub-system. */
+	if (priv->mode == PHY_TYPE_USB3)
+		sun55i_combphy_rmw(priv->ctl + USB3_BGR, 0, USB3_BGR_ENABLE_MASK);
+	else
+		sun55i_combphy_rmw(priv->ctl + PCIE_BGR, 0, PCIE_BGR_ENABLE_MASK);
+}
+
+/* Assert the PHY reset and gate the bus clocks of the used sub-system. */
+static void sun55i_combphy_subsys_disable(struct sun55i_combphy *priv)
+{
+	u32 clear, set;
+
+	if (priv->mode == PHY_TYPE_USB3) {
+		clear = PHY_CLK_SEL | PHY_RSTN;
+		set = PHY_USE_SEL;
+	} else {
+		clear = PHY_CLK_SEL | PHY_RSTN | PHY_USE_SEL;
+		set = 0;
+	}
+
+	sun55i_combphy_rmw(priv->ctl + PHYCTL, clear, set);
+
+	if (priv->mode == PHY_TYPE_USB3)
+		sun55i_combphy_rmw(priv->ctl + USB3_BGR, USB3_BGR_ENABLE_MASK, 0);
+	else
+		sun55i_combphy_rmw(priv->ctl + PCIE_BGR, PCIE_BGR_ENABLE_MASK, 0);
+}
+
+/*
+ * Additional PCIe-specific lane bring-up: enable the PCIe side of the
+ * sub-system and pulse the PHY reset.
+ */
+static void sun55i_combphy_pcie_lane_enable(struct sun55i_combphy *priv)
+{
+	u32 val;
+
+	val = readl(priv->ctl + PCIE_BGR);
+	val &= ~(GENMASK(1, 0) | GENMASK(18, 16));
+	val |= PCIE_BGR_ENABLE_MASK;
+	writel(val, priv->ctl + PCIE_BGR);
+
+	/* PCIe mode; assert the PHY reset. */
+	sun55i_combphy_rmw(priv->ctl + PHYCTL,
+			   PHY_USE_SEL | PHY_PIPE_SW_SEL | PHY_RSTN, 0);
+
+	udelay(10);
+
+	/* Internal reference clock; release the PHY reset. */
+	sun55i_combphy_rmw(priv->ctl + PHYCTL, PHY_CLK_SEL, PHY_RSTN);
+}
+
+static void sun55i_combphy_usb3_power(struct sun55i_combphy *priv, bool on)
+{
+	if (on) {
+		sun55i_combphy_rmw(priv->base + 0x14, BIT(26), 0);
+		sun55i_combphy_rmw(priv->base + 0x0, BIT(10), 0);
+	} else {
+		sun55i_combphy_rmw(priv->base + 0x14, 0, BIT(26));
+		sun55i_combphy_rmw(priv->base + 0x0, 0, BIT(10));
+	}
+}
+
+static int sun55i_combphy_power_up(struct sun55i_combphy *priv)
+{
+	bool already_enabled;
+	int ret;
+
+	if (priv->initialized)
+		return 0;
+
+	already_enabled = readl(priv->ctl + PHYCTL) & PHY_RSTN;
+	if (already_enabled)
+		dev_dbg(priv->dev, "PHY already enabled by the bootloader\n");
+
+	if (!already_enabled) {
+		ret = reset_control_deassert(priv->reset);
+		if (ret)
+			return ret;
+
+		ret = clk_set_rate(priv->ref_clk, 100 * HZ_PER_MHZ);
+		if (ret)
+			goto err_assert_reset;
+	}
+
+	ret = clk_prepare_enable(priv->ref_clk);
+	if (ret)
+		goto err_assert_reset;
+
+	if (!already_enabled)
+		sun55i_combphy_subsys_enable(priv);
+
+	switch (priv->mode) {
+	case PHY_TYPE_PCIE:
+		sun55i_combphy_pcie_tune(priv);
+		sun55i_combphy_pcie_lane_enable(priv);
+		break;
+	case PHY_TYPE_USB3:
+		sun55i_combphy_usb3_tune(priv, true);
+		break;
+	default:
+		ret = -EINVAL;
+		goto err_disable_clk;
+	}
+
+	priv->initialized = true;
+
+	return 0;
+
+err_disable_clk:
+	clk_disable_unprepare(priv->ref_clk);
+err_assert_reset:
+	reset_control_assert(priv->reset);
+	return ret;
+}
+
+static int sun55i_combphy_power_down(struct sun55i_combphy *priv)
+{
+	if (!priv->initialized)
+		return 0;
+
+	if (priv->mode == PHY_TYPE_USB3)
+		sun55i_combphy_usb3_tune(priv, false);
+
+	sun55i_combphy_subsys_disable(priv);
+	clk_disable_unprepare(priv->ref_clk);
+	reset_control_assert(priv->reset);
+
+	priv->initialized = false;
+
+	return 0;
+}
+
+static int sun55i_combphy_phy_init(struct phy *phy)
+{
+	struct sun55i_combphy *priv = phy_get_drvdata(phy);
+
+	return sun55i_combphy_power_up(priv);
+}
+
+static int sun55i_combphy_phy_exit(struct phy *phy)
+{
+	struct sun55i_combphy *priv = phy_get_drvdata(phy);
+
+	return sun55i_combphy_power_down(priv);
+}
+
+static int sun55i_combphy_phy_power_on(struct phy *phy)
+{
+	struct sun55i_combphy *priv = phy_get_drvdata(phy);
+
+	if (priv->mode == PHY_TYPE_USB3)
+		sun55i_combphy_usb3_power(priv, true);
+
+	return 0;
+}
+
+static int sun55i_combphy_phy_power_off(struct phy *phy)
+{
+	struct sun55i_combphy *priv = phy_get_drvdata(phy);
+
+	if (priv->mode == PHY_TYPE_USB3)
+		sun55i_combphy_usb3_power(priv, false);
+
+	return 0;
+}
+
+static const struct phy_ops sun55i_combphy_ops = {
+	.init		= sun55i_combphy_phy_init,
+	.exit		= sun55i_combphy_phy_exit,
+	.power_on	= sun55i_combphy_phy_power_on,
+	.power_off	= sun55i_combphy_phy_power_off,
+	.owner		= THIS_MODULE,
+};
+
+static struct phy *sun55i_combphy_xlate(struct device *dev,
+					const struct of_phandle_args *args)
+{
+	struct sun55i_combphy *priv = dev_get_drvdata(dev);
+
+	if (args->args_count != 1)
+		return ERR_PTR(-EINVAL);
+
+	switch (args->args[0]) {
+	case PHY_TYPE_PCIE:
+	case PHY_TYPE_USB3:
+		break;
+	default:
+		dev_err(dev, "invalid PHY type %d\n", args->args[0]);
+		return ERR_PTR(-EINVAL);
+	}
+
+	if (priv->mode != PHY_NONE && priv->mode != args->args[0])
+		dev_warn(dev, "PHY type %d requested while type %d is in use\n",
+			 args->args[0], priv->mode);
+
+	priv->mode = args->args[0];
+
+	/*
+	 * The consumer's register block sits behind its sub-system bus
+	 * gate: open it as soon as a consumer attaches, before it
+	 * touches any register. The DWC3 host driver for instance reads
+	 * its IP ID register during probe, before powering the PHY on,
+	 * and gets garbage unless USB3_BGR is set.
+	 */
+	if (args->args[0] == PHY_TYPE_USB3)
+		sun55i_combphy_rmw(priv->ctl + USB3_BGR, 0,
+				   USB3_BGR_ENABLE_MASK);
+	else
+		sun55i_combphy_rmw(priv->ctl + PCIE_BGR, 0,
+				   PCIE_BGR_ENABLE_MASK);
+
+	return priv->phy;
+}
+
+static int sun55i_combphy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct phy_provider *provider;
+	struct sun55i_combphy *priv;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+	priv->mode = PHY_NONE;
+
+	priv->ctl = devm_platform_ioremap_resource_byname(pdev, "phy-ctl");
+	if (IS_ERR(priv->ctl))
+		return PTR_ERR(priv->ctl);
+
+	priv->base = devm_platform_ioremap_resource_byname(pdev, "phy-clk");
+	if (IS_ERR(priv->base))
+		return PTR_ERR(priv->base);
+
+	priv->ref_clk = devm_clk_get(dev, "phyclk_ref");
+	if (IS_ERR(priv->ref_clk))
+		return dev_err_probe(dev, PTR_ERR(priv->ref_clk),
+				     "failed to get phyclk_ref clock\n");
+
+	priv->ref_parent = devm_clk_get(dev, "refclk_par");
+	if (IS_ERR(priv->ref_parent))
+		return dev_err_probe(dev, PTR_ERR(priv->ref_parent),
+				     "failed to get refclk_par clock\n");
+
+	ret = clk_set_parent(priv->ref_clk, priv->ref_parent);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to set phyclk_ref parent\n");
+
+	priv->reset = devm_reset_control_get_exclusive(dev, "phy_rst");
+	if (IS_ERR(priv->reset))
+		return dev_err_probe(dev, PTR_ERR(priv->reset),
+				     "failed to get phy_rst reset\n");
+
+	priv->phy = devm_phy_create(dev, NULL, &sun55i_combphy_ops);
+	if (IS_ERR(priv->phy))
+		return dev_err_probe(dev, PTR_ERR(priv->phy),
+				     "failed to create PHY\n");
+
+	phy_set_drvdata(priv->phy, priv);
+	platform_set_drvdata(pdev, priv);
+
+	provider = devm_of_phy_provider_register(dev, sun55i_combphy_xlate);
+
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static void sun55i_combphy_remove(struct platform_device *pdev)
+{
+	struct sun55i_combphy *priv = platform_get_drvdata(pdev);
+
+	sun55i_combphy_power_down(priv);
+}
+
+static int sun55i_combphy_suspend(struct device *dev)
+{
+	struct sun55i_combphy *priv = dev_get_drvdata(dev);
+
+	return sun55i_combphy_power_down(priv);
+}
+
+static int sun55i_combphy_resume(struct device *dev)
+{
+	struct sun55i_combphy *priv = dev_get_drvdata(dev);
+
+	return sun55i_combphy_power_up(priv);
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(sun55i_combphy_pm_ops,
+				sun55i_combphy_suspend,
+				sun55i_combphy_resume);
+
+static const struct of_device_id sun55i_combphy_of_match[] = {
+	{ .compatible = "allwinner,sun55i-a523-combophy" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sun55i_combphy_of_match);
+
+static struct platform_driver sun55i_combphy_driver = {
+	.probe	= sun55i_combphy_probe,
+	.remove	= sun55i_combphy_remove,
+	.driver = {
+		.name		= "sun55i-combophy",
+		.of_match_table	= sun55i_combphy_of_match,
+		.pm		= pm_ptr(&sun55i_combphy_pm_ops),
+	},
+};
+module_platform_driver(sun55i_combphy_driver);
+
+MODULE_DESCRIPTION("Allwinner A523/T527 USB3.0/PCIe combo PHY driver");
+MODULE_AUTHOR("songjundong@allwinnertech.com");
+MODULE_AUTHOR("Mikhail Kalashnikov <iuncuim@gmail.com>");
+MODULE_LICENSE("GPL v2");
-- 
